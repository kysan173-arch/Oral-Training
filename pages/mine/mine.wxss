.mine-page { padding: 30rpx 24rpx calc(150rpx + env(safe-area-inset-bottom)); background: var(--bg-grad, #F7F5F1); }

/* ── 骨架加载 ── */
.skeleton-block { padding: 0 4rpx; }
.skeleton-hero { height: 160rpx; border-radius: 24rpx; background: linear-gradient(90deg, #e8eaf0 25%, #dfe1ea 50%, #e8eaf0 75%); background-size: 200% 100%; animation: skeleton-shimmer 1.6s infinite; }
.skeleton-stats { display: flex; gap: 14rpx; margin-top: 20rpx; }
.skeleton-stat { flex: 1; height: 100rpx; border-radius: 24rpx; background: linear-gradient(90deg, #e8eaf0 25%, #dfe1ea 50%, #e8eaf0 75%); background-size: 200% 100%; animation: skeleton-shimmer 1.6s infinite; }
.skeleton-calendar { height: 320rpx; margin-top: 28rpx; border-radius: 24rpx; background: linear-gradient(90deg, #e8eaf0 25%, #dfe1ea 50%, #e8eaf0 75%); background-size: 200% 100%; animation: skeleton-shimmer 1.6s infinite; }
.skeleton-row, .skeleton-row-short { height: 48rpx; margin-top: 18rpx; border-radius: 12rpx; background: linear-gradient(90deg, #e8eaf0 25%, #dfe1ea 50%, #e8eaf0 75%); background-size: 200% 100%; animation: skeleton-shimmer 1.6s infinite; }
.skeleton-row-short { width: 60%; margin-top: 22rpx; }
@keyframes skeleton-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* 过渡态 */
.loading-card { padding: 50rpx 28rpx; color: var(--text-secondary); font-size: 26rpx; text-align: center; }
.role-redirect { margin-top: 20rpx; padding: 14rpx 28rpx; border-radius: 28rpx; color: #fff; background: var(--color-primary); font-size: 22rpx; font-weight: 600; display: inline-block; }

/* ── Hero 个人卡片（白底克制） ── */
.mine-hero { position: relative; display: flex; align-items: flex-start; padding: 32rpx 28rpx 24rpx; border-radius: 24rpx; color: var(--text-strong); background: #fff; border: 1rpx solid var(--color-border); }
.admin-hero { background: var(--color-primary-light); border-color: var(--color-primary-light); }
.hero-avatar { width: 82rpx; height: 82rpx; border-radius: 50%; margin-right: 22rpx; border: 3rpx solid var(--color-border); flex-shrink: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; background: var(--color-primary-light); }
.hero-avatar-text { font-size: 32rpx; font-weight: 600; color: var(--color-primary); }
.hero-avatar-img { width: 100%; height: 100%; }
.hero-info { flex: 1; min-width: 0; }
.hero-name-row { display: flex; align-items: center; gap: 14rpx; }
.hero-name { font-size: 36rpx; font-weight: 600; color: var(--text-strong); }
.hero-level-tag { padding: 4rpx 16rpx; border-radius: 14rpx; background: var(--color-primary-light); font-size: 22rpx; font-weight: 600; color: var(--color-primary); }
.hero-subtitle { display: block; margin-top: 8rpx; color: var(--text-secondary); font-size: 24rpx; line-height: 1.4; max-width: 440rpx; }
.hero-level-row { display: flex; align-items: center; margin-top: 14rpx; gap: 12rpx; }
.hero-level-bar { flex: 1; height: 10rpx; border-radius: 6rpx; background: var(--color-border); overflow: hidden; }
.hero-level-fill { height: 100%; border-radius: 6rpx; background: var(--color-primary); transition: width .3s; }
.hero-level-text { font-size: 22rpx; color: var(--text-secondary); white-space: nowrap; }
.hero-level-max { display: block; margin-top: 12rpx; color: var(--color-primary); font-size: 22rpx; font-weight: 600; }

/* ── 主管角色徽章 ── */
.admin-role-badge { padding: 5rpx 18rpx; border-radius: 14rpx; background: #fff; font-size: 22rpx; font-weight: 600; color: var(--color-primary); border: 1rpx solid var(--color-border); }
.admin-role-badge::before { content: ''; display: inline-block; width: 8rpx; height: 8rpx; margin-right: 8rpx; border-radius: 50%; background: var(--color-primary); vertical-align: middle; }

/* ── 主管账号信息卡 ── */
.admin-account { padding: 6rpx 22rpx; }
.admin-account-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--color-border); }
.admin-account-row:last-child { border-bottom: none; }
.admin-account-label { color: var(--text-secondary); font-size: 26rpx; }
.admin-account-value { color: var(--text-strong); font-size: 26rpx; font-weight: 600; }

/* Hero 底部（积分 + 角色切换） */
.hero-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid var(--color-border); }
.hero-points { display: flex; align-items: baseline; gap: 8rpx; }
.hero-points-val { font-size: 32rpx; font-weight: 600; color: var(--text-strong); }
.hero-points-lbl { font-size: 22rpx; color: var(--text-secondary); }
.hero-role-switch { display: flex; align-items: center; gap: 6rpx; padding: 10rpx 4rpx; }
.hero-role-icon { font-size: 22rpx; font-weight: 600; color: var(--color-primary); }
.hero-role-label { font-size: 22rpx; color: var(--text-secondary); }

/* ── 统计卡（白卡 + 深色数字，均分铺满） ── */
.stat-scroll { margin-top: 20rpx; }
.stat-row { display: flex; gap: 14rpx; }
.stat-card { flex: 1; min-width: 0; box-sizing: border-box; padding: 20rpx 6rpx 16rpx; text-align: center; border-radius: 20rpx; background: #fff; border: 1rpx solid var(--color-border); }
.stat-icon { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin: 0 auto 8rpx; border-radius: 14rpx; background: var(--color-primary-light); }
.stat-icon-img { width: 32rpx; height: 32rpx; }
.stat-val { display: block; font-size: 32rpx; font-weight: 600; letter-spacing: .5rpx; color: var(--text-strong); }
.stat-lbl { display: block; margin-top: 6rpx; font-size: 22rpx; color: var(--text-secondary); }

/* ── 签到区 ── */
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 5rpx 14rpx; }
.section-heading view text { display: block; }
.section-heading view text:first-child { color: var(--text-strong); font-size: 32rpx; font-weight: 600; }
.section-heading view text:last-child { margin-top: 4rpx; color: var(--text-secondary); font-size: 22rpx; }
.checkin-head { display: flex; align-items: baseline; gap: 10rpx; flex: 1; min-width: 0; }
.checkin-head > text { white-space: nowrap; }
.checkin-toggle { margin-top: 0 !important; color: var(--color-primary) !important; font-size: 22rpx !important; font-weight: 400 !important; flex-shrink: 0; }
.streak-sub { margin-top: 0 !important; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-secondary); font-size: 22rpx; flex-shrink: 1; min-width: 0; }
.streak-sub.streak-hot { color: var(--color-warning); font-weight: 600; }
.checkin-wrap { position: relative; flex-shrink: 0; }
.checkin-button { width: 172rpx; height: 58rpx; line-height: 58rpx; margin: 0; padding: 0; border-radius: 30rpx; color: #fff; background: var(--color-primary); font-size: 22rpx; font-weight: 400; transition: transform .12s, opacity .12s; }
.checkin-button:active { transform: scale(.96); opacity: .85; }
.checkin-button.checked, .checkin-button[disabled] { color: var(--color-primary); background: var(--color-primary-light); }
.checkin-burst { position: absolute; top: -8rpx; right: -14rpx; padding: 4rpx 14rpx; border-radius: 20rpx; color: #fff; font-size: 22rpx; font-weight: 600; background: var(--color-warning); opacity: 0; pointer-events: none; }
.checkin-burst-active { animation: burst-pop .7s ease; }
@keyframes burst-pop {
  0% { transform: scale(.4) translateY(6rpx); opacity: 0; }
  30% { transform: scale(1.15) translateY(-4rpx); opacity: 1; }
  70% { transform: scale(1) translateY(-10rpx); opacity: 1; }
  100% { transform: scale(.9) translateY(-20rpx); opacity: 0; }
}

/* 签到数据（列表式：图标 + 标签 + 数值靠右，与上方卡片式区分） */
.checkin-list { display: flex; flex-direction: column; padding: 6rpx 24rpx; margin: 0 0 20rpx; }
.checkin-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--color-border); }
.checkin-item:last-child { border-bottom: none; }
.checkin-item-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; flex-shrink: 0; border-radius: 16rpx; background: var(--color-primary-light); }
.checkin-item-img { width: 32rpx; height: 32rpx; }
.checkin-item-label { flex: 1; margin-left: 16rpx; color: var(--text-body); font-size: 26rpx; }
.checkin-item-value { color: var(--text-strong); font-size: 26rpx; font-weight: 600; }
.checkin-item-unit { margin-left: 4rpx; color: #B5A89B; font-size: 22rpx; font-weight: 600; }
.checkin-item-value.item-done { color: var(--color-primary); }
.checkin-item-value.item-todo { color: #B5A89B; font-weight: 600; }

/* 日历（紧凑版：居中标题 + 圆角方块 + 间隙 + 今天紫色实心） */
.calendar-card { padding: 20rpx 18rpx 22rpx; }
.calendar-title { display: block; color: var(--text-strong); font-size: 26rpx; font-weight: 600; text-align: center; letter-spacing: 1rpx; margin-bottom: 16rpx; }
.weekdays, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.weekdays { margin-bottom: 10rpx; color: #B5A89B; font-size: 22rpx; font-weight: 400; text-align: center; }
.calendar-grid { row-gap: 10rpx; column-gap: 8rpx; padding: 0 2rpx; }
.calendar-cell { display: flex; align-items: center; justify-content: center; height: 60rpx; border-radius: 14rpx; color: var(--text-strong); font-size: 22rpx; font-weight: 600; text-align: center; background: #fff; border: 1rpx solid var(--color-border); box-shadow: 0 1rpx 2rpx rgba(0,0,0,.02); transition: transform .15s; }
.calendar-cell.is-empty { border: none; background: transparent; box-shadow: none; }
.calendar-cell.checked { color: #fff; background: var(--color-primary); border-color: var(--color-primary); font-weight: 600; box-shadow: 0 3rpx 8rpx rgba(31,56,100,.18); }
.calendar-cell.today { color: #fff; background: var(--color-primary); border-color: transparent; font-weight: 600; font-size: 26rpx; box-shadow: 0 4rpx 10rpx rgba(31,56,100,.2), 0 0 0 3rpx rgba(31,56,100,.1); }
.calendar-cell.today.checked { background: var(--color-primary); }
.calendar-cell:active { transform: scale(.96); }

/* 积分规则（可折叠） */
.rules-card { padding: 0 22rpx; margin-top: 14rpx; overflow: hidden; }
.rules-header { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; }
.rules-header-left { display: flex; align-items: center; gap: 10rpx; }
.rules-header-icon { display: inline-flex; align-items: center; justify-content: center; padding: 4rpx 10rpx; border-radius: 8rpx; background: var(--color-primary-light); color: var(--color-primary); font-size: 22rpx; font-weight: 600; }
.rules-header-title { color: var(--text-strong); font-size: 26rpx; font-weight: 600; }
.rules-toggle-icon { color: var(--color-primary); font-size: 22rpx; font-weight: 600; padding: 6rpx 16rpx; border-radius: 20rpx; background: var(--color-primary-light); transition: all .2s; }
.rules-toggle-icon.expanded { color: var(--text-secondary); background: var(--color-bg); }
.rules-summary { padding: 0 0 22rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.5; }
.rules-detail { padding-bottom: 8rpx; }
.rules-divider { height: 1rpx; margin-bottom: 6rpx; background: var(--color-border); }
.rule-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; }
.rule-name, .rule-description { display: block; }
.rule-name { color: var(--text-strong); font-size: 26rpx; font-weight: 600; }
.rule-description { margin-top: 5rpx; color: var(--text-secondary); font-size: 22rpx; }
.rule-points { color: var(--color-primary); font-size: 26rpx; font-weight: 600; }

/* 板块软分割 */
.section-spacer { height: 12rpx; margin: 30rpx 4rpx 6rpx; border-radius: 6rpx; background: var(--color-border); }

/* ── 工具卡（浅色图标 + 中文双行） ── */
.tool-card { display: flex; align-items: center; padding: 24rpx 22rpx 24rpx 22rpx; margin-bottom: 16rpx; border-radius: 22rpx; background: #fff; border: 1rpx solid var(--color-border); position: relative; overflow: hidden; }
.tool-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5rpx; background: var(--color-primary); }
.tool-icon-wrap { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; flex-shrink: 0; border-radius: 20rpx; background: var(--color-primary-light); }
.tool-icon-img { width: 44rpx; height: 44rpx; }
.tool-body { flex: 1; margin-left: 16rpx; min-width: 0; display: flex; flex-direction: column; }
.tool-title { color: var(--text-strong); font-size: 26rpx; font-weight: 600; line-height: 1.3; }
.tool-sub { margin-top: 6rpx; color: var(--text-muted); font-size: 22rpx; font-weight: 400; letter-spacing: .5rpx; }
.tool-arrow { color: var(--text-muted); font-size: 32rpx; margin-left: 8rpx; flex-shrink: 0; }

/* 个人成长 略微突出 */
.tool-prominent { padding-top: 26rpx; padding-bottom: 26rpx; box-shadow: 0 0 0 2rpx rgba(31, 56, 100, .12), 0 4rpx 16rpx rgba(0, 0, 0, .06); }

/* ── 切换演示账号入口 ── */
.demo-switch-entry { display: flex; align-items: center; gap: 8rpx; margin-top: 16rpx; padding: 12rpx 18rpx; border-radius: 16rpx; background: var(--color-primary-light); }
.demo-switch-icon { font-size: 26rpx; }
.demo-switch-text { color: var(--color-primary); font-size: 22rpx; }

/* ── 切换账号面板 ── */
.demo-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; background: rgba(0,0,0,.4); }
.demo-picker { position: fixed; left: 0; right: 0; bottom: 0; z-index: 101; padding: 28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); background: #fff; border-radius: 28rpx 28rpx 0 0; transform: translateY(100%); transition: transform .25s ease; }
.demo-picker-show { transform: translateY(0); }
.demo-picker-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.demo-picker-title { font-size: 32rpx; font-weight: 600; color: var(--text-strong); }
.demo-picker-close { padding: 6rpx 16rpx; border-radius: 16rpx; color: var(--color-primary); background: var(--color-primary-light); font-size: 22rpx; }
.demo-picker-list { max-height: 520rpx; }
.demo-account { display: flex; align-items: center; padding: 20rpx 12rpx; border-radius: 16rpx; }
.demo-account + .demo-account { border-top: 1rpx solid #F0F0F2; }
.demo-account.selected { background: var(--color-primary-light); }
.demo-account-icon { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; flex-shrink: 0; border-radius: 16rpx; color: #fff; background: var(--color-primary); font-size: 24rpx; font-weight: 600; }
.demo-account-copy { flex: 1; min-width: 0; margin-left: 16rpx; }
.demo-account-name { display: block; font-size: 26rpx; font-weight: 600; color: var(--text-strong); }
.demo-account-role { display: block; margin-top: 4rpx; font-size: 22rpx; color: var(--text-secondary); }
.demo-account-check { flex-shrink: 0; color: var(--color-primary); font-size: 32rpx; }
.demo-picker-tip { margin-top: 20rpx; padding: 16rpx 20rpx; border-radius: 14rpx; color: var(--text-secondary); background: #F7F8FA; font-size: 22rpx; line-height: 1.5; }
