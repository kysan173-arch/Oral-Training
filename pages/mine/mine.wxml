<view class="mine-page">
  <!-- 用户信息卡 -->
  <view class="user-card">
    <view class="user-info">
      <view class="avatar">{{level.icon}}</view>
      <view class="user-text">
        <text class="user-name">客服学员</text>
        <text class="user-level">{{level.name}}</text>
      </view>
    </view>
    <view class="user-stats">
      <view class="user-points">
        <text class="up-value">{{points}}</text>
        <text class="up-label">积分</text>
      </view>
      <view class="level-bar-wrap">
        <view class="level-bar">
          <view class="level-bar-fill" style="width:{{levelProgress}}%;"></view>
        </view>
        <text class="level-hint">距下一级还需升级</text>
      </view>
    </view>
  </view>

  <!-- 训练统计 -->
  <view class="stats-row">
    <view class="stats-item">
      <text class="si-value">{{stats.totalCompleted}}</text>
      <text class="si-label">累计训练</text>
    </view>
    <view class="stats-item">
      <text class="si-value">{{stats.passRate}}%</text>
      <text class="si-label">通过率</text>
    </view>
    <view class="stats-item">
      <text class="si-value">{{stats.avgScore}}</text>
      <text class="si-label">平均分</text>
    </view>
    <view class="stats-item">
      <text class="si-value">{{stats.checkinDays}}</text>
      <text class="si-label">打卡天数</text>
    </view>
  </view>

  <!-- 打卡日历 -->
  <view class="section-header">
    <text class="section-title">打卡日历</text>
    <view class="section-right">
      <text class="streak-info" wx:if="{{streakDays > 0}}">连续 {{streakDays}} 天</text>
      <view class="checkin-btn {{checkedToday ? 'checked' : ''}}" bindtap="onCheckin">
        <text>{{checkedToday ? '✓ 已打卡' : '点我打卡 +10'}}</text>
      </view>
    </view>
  </view>
  <view class="calendar-card card">
    <view class="calendar-header">
      <text>{{calendar.year}}年{{calendar.month}}月</text>
    </view>
    <view class="weekday-row">
      <text class="weekday" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="day-grid">
      <view class="day-cell {{item.checked ? 'checked' : ''}} {{item.isToday ? 'today' : ''}}" wx:for="{{calendar.days}}" wx:key="index">
        <text class="day-num" wx:if="{{item.day}}">{{item.day}}</text>
      </view>
    </view>
  </view>

  <!-- 积分规则 -->
  <view class="section-header">
    <text class="section-title">积分规则</text>
    <text class="section-link" bindtap="toggleRules">{{showRules ? '收起 ▲' : '展开 ▼'}}</text>
  </view>
  <view class="rules-card card" wx:if="{{showRules}}">
    <view class="rule-row" wx:for="{{pointsRules}}" wx:key="action">
      <text class="rule-action">{{item.action}}</text>
      <text class="rule-points">{{item.points}}</text>
      <text class="rule-desc">{{item.desc}}</text>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="section-header">
    <text class="section-title">快捷入口</text>
  </view>
  <view class="shortcuts">
    <view class="shortcut-item card" bindtap="goProfile">
      <text class="sc-emoji">📊</text>
      <text class="sc-text">能力画像</text>
      <text class="sc-arrow">›</text>
    </view>
    <view class="shortcut-item card" bindtap="goMistakes">
      <text class="sc-emoji">📝</text>
      <text class="sc-text">错题本</text>
      <text class="sc-arrow">›</text>
    </view>
    <view class="shortcut-item card" bindtap="goFavorites">
      <text class="sc-emoji">⭐</text>
      <text class="sc-text">话术收藏
      <text class="sc-tag" wx:if="{{favoritesCount > 0}}">{{favoritesCount}}</text></text>
      <text class="sc-arrow">›</text>
    </view>
  </view>

  <!-- 排行榜 -->
  <view class="section-header">
    <text class="section-title">积分排行</text>
  </view>
  <view class="leader-card card">
    <view class="leader-row" wx:for="{{leaderboard}}" wx:key="rank">
      <text class="lr-rank {{item.rank <= 3 ? 'top-' + item.rank : ''}}">{{item.rank <= 3 ? ['🥇','🥈','🥉'][item.rank-1] : item.rank}}</text>
      <text class="lr-name">{{item.name}}</text>
      <text class="lr-points">{{item.points}} 分</text>
    </view>
    <view class="leader-empty" wx:if="{{leaderboard.length === 0}}">
      <text>暂无排行数据</text>
    </view>
  </view>

  <text class="disclaimer">积分与等级主要用于激励训练，不具备实际考核效力。</text>
</view>
