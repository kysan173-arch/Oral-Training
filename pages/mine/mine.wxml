<view class="mine-page">
  <view wx:if="{{errorMessage}}" class="error-card">
    <text>{{errorMessage}}</text>
    <button bindtap="loadDashboard">重新加载</button>
  </view>

  <!-- User info card -->
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
    <view class="user-info">
      <text class="nickname">{{userInfo.nickname}}</text>
      <view class="user-meta">
        <text class="user-level">Lv.{{userInfo.level}}</text>
        <text class="user-points">{{userInfo.points}} 积分</text>
      </view>
    </view>
  </view>

  <!-- Check-in calendar -->
  <view class="section-card calendar-card">
    <view class="card-header">
      <text class="card-title">打卡日历</text>
      <view class="streak-badge" wx:if="{{checkInStreak > 0}}">
        <text>已连续 {{checkInStreak}} 天</text>
      </view>
    </view>

    <view class="calendar-grid">
      <text class="weekday" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">{{item}}</text>
      <view
        class="day-cell {{item.isToday ? 'today' : ''}} {{item.checked ? 'checked' : ''}}"
        wx:for="{{checkInDays}}"
        wx:key="index"
      >
        <text wx:if="{{item.day}}">{{item.day}}</text>
      </view>
    </view>

    <button
      class="checkin-btn {{todayChecked ? 'checked-disabled' : ''}}"
      bindtap="doCheckIn"
      disabled="{{todayChecked}}"
    >{{todayChecked ? '今日已打卡 ✓' : '今日打卡 +10分'}}</button>
  </view>

  <!-- Training stats -->
  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-value">{{totalSessions}}</text>
      <text class="stat-label">累计训练</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{passRate}}%</text>
      <text class="stat-label">通过率</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{averageScore}}</text>
      <text class="stat-label">平均得分</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{checkInStreak}}</text>
      <text class="stat-label">连续打卡</text>
    </view>
  </view>

  <!-- Achievements -->
  <view class="section-card">
    <view class="card-header">
      <text class="card-title">成就徽章</text>
      <text class="card-sub">{{earnedCount}}/{{achievements.length}}</text>
    </view>
    <view class="achievement-grid">
      <view class="achievement-item {{item.earned ? 'earned' : ''}}" wx:for="{{achievements}}" wx:key="id">
        <text class="achievement-icon">{{item.earned ? item.icon : '🔒'}}</text>
        <text class="achievement-name">{{item.name}}</text>
        <text class="achievement-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- Leaderboard -->
  <view class="section-card">
    <view class="card-header" bindtap="toggleLeaderboard">
      <text class="card-title">团队排行榜</text>
      <text class="card-toggle">{{showLeaderboard ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
    <view wx:if="{{showLeaderboard}}" class="leaderboard-list">
      <view class="leader-item {{item.isMe ? 'is-me' : ''}}" wx:for="{{leaderboard}}" wx:key="name">
        <text class="leader-rank rank-{{index < 3 ? index + 1 : ''}}">{{index + 1}}</text>
        <text class="leader-name">{{item.name}}</text>
        <text class="leader-sessions">{{item.sessions}}次</text>
        <text class="leader-score">{{item.score}}分</text>
      </view>
    </view>
  </view>

  <!-- Quick entries -->
  <view class="entry-list">
    <view class="entry-card" bindtap="goPhraseVault">
      <view class="entry-icon icon-gold">★</view>
      <view class="entry-info">
        <text class="entry-name">话术收藏夹</text>
        <text class="entry-desc">查看已收藏的高转化话术</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">加载中...</view>
</view>
