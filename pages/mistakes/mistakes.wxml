<view class="page-shell mistakes-page">
  <view class="page-header">
    <text class="page-title">错题复练</text>
    <text class="page-intro">错题按训练场次归类，每场收起或展开互不影响。点某一轮可收起它的详细内容。</text>
  </view>

  <view class="toolbar card"><text>显示已掌握项目</text><switch checked="{{includeMastered}}" color="#1F3864" bindchange="toggleMastered" /></view>

  <view class="mistake-skeleton" wx:if="{{loading}}">
    <view class="sk-card"></view>
    <view class="sk-card"></view>
    <view class="sk-card"></view>
  </view>

  <view class="empty-card card" wx:elif="{{groups.length === 0}}">
    <empty-state title="{{includeMastered ? '还没有错题记录' : '暂时没有待复练项目'}}" text="完成训练并生成报告后，系统会把需要改进的表达收录在这里。" actionText="去话术锦囊看看" bind:action="goPhrases"></empty-state>
  </view>

  <view class="group-list" wx:else>
    <view class="group-card card" wx:for="{{groups}}" wx:key="key" wx:for-item="group">
      <view class="group-head" hover-class="row-hover" bindtap="toggleGroup" data-group-key="{{group.key}}">
        <view class="group-head-main">
          <text class="group-date">{{group.dateText}}</text>
          <text class="group-scene">{{group.scenarioName}}</text>
        </view>
        <view class="group-head-side">
          <text class="group-count">{{group.summaryText}}</text>
          <text class="group-caret">{{group.expanded ? '▾' : '▸'}}</text>
        </view>
      </view>

      <view class="group-body" wx:if="{{group.expanded}}">
        <view class="mistake-item {{item.mastered ? 'mastered-item' : ''}}" wx:for="{{group.items}}" wx:key="id" wx:for-item="item">
          <view class="item-row" hover-class="row-hover" bindtap="toggleItem" data-item-id="{{item.id}}">
            <view class="item-row-main">
              <view class="item-title-row">
                <text class="item-round">{{item.roundLabel}}</text>
                <text class="item-kind">{{item.kindLabel}}</text>
              </view>
              <text class="item-preview" wx:if="{{!item.expanded && item.previewText}}">{{item.previewText}}</text>
            </view>
            <view class="item-row-side">
              <text class="item-mastered" wx:if="{{item.mastered}}">已掌握</text>
              <text class="priority {{item.priorityClass}}">{{item.priorityLabel}}</text>
              <text class="item-caret">{{item.expanded ? '▾' : '▸'}}</text>
            </view>
          </view>

          <view class="item-detail" wx:if="{{item.expanded}}">
            <view class="quote-box" wx:if="{{item.originalQuote}}"><text class="field-label">当时表达</text><text>“{{item.originalQuote}}”</text></view>
            <view class="reason-box"><text class="field-label">为什么需要调整</text><text>{{item.reason}}</text></view>
            <view class="rewrite-box"><text class="field-label">建议改写</text><text>{{item.recommendedRewrite}}</text></view>
            <view class="mistake-actions"><text class="mastery-action" bindtap="toggleMastery" data-id="{{item.id}}" data-session-id="{{item.sessionId}}" data-mistake-key="{{item.mistakeKey}}" data-mastered="{{item.mastered}}">{{savingId === item.id ? '保存中…' : item.mastered ? '恢复为待练习' : '标记已掌握'}}</text><text class="retrain-action" bindtap="retrainRound" data-session-id="{{item.sessionId}}" data-mistake-key="{{item.mistakeKey}}">重练本回合 ›</text><text class="retrain-action" bindtap="retrain" data-scenario-id="{{item.scenarioId}}">用此场景复练 ›</text></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
