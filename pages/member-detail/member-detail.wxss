.member-detail-page { padding: 0 0 48rpx; }
.member-header {
  display: flex; align-items: center; margin: 24rpx 24rpx 20rpx; padding: 24rpx;
}
.mh-avatar { font-size: 52rpx; margin-right: 18rpx; }
.mh-info { flex: 1; }
.mh-name { display: block; font-size: 29rpx; font-weight: 700; color: #333; }
.mh-role { display: block; margin-top: 4rpx; font-size: 21rpx; color: #667eea; }
.mh-meta { display: block; margin-top: 4rpx; font-size: 19rpx; color: #aaa; }
.mh-stats { display: flex; gap: 20rpx; }
.mhs-item { display: flex; flex-direction: column; align-items: center; }
.mhs-val { font-size: 28rpx; font-weight: 700; color: #667eea; }
.mhs-label { font-size: 18rpx; color: #aaa; }

.section-header { margin: 28rpx 28rpx 12rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #333; }

.radar-wrap { margin: 0 24rpx; padding: 20rpx; }
.radar-canvas { width: 100%; height: 360rpx; }
.dim-bar-list { margin-top: 16rpx; }
.dim-bar-row { display: flex; align-items: center; padding: 8rpx 0; }
.dim-bar-name { width: 120rpx; font-size: 21rpx; color: #555; }
.dim-bar-bar { flex: 1; height: 10rpx; border-radius: 5rpx; background: #f0f0f4; margin: 0 14rpx; overflow: hidden; }
.dim-bar-fill { height: 100%; border-radius: 5rpx; transition: width .4s; }
.dim-bar-val { width: 40rpx; font-size: 21rpx; color: #333; font-weight: 600; text-align: right; }

.growth-card { margin: 0 24rpx; padding: 30rpx 20rpx 16rpx; }
.growth-chart { position: relative; height: 240rpx; }
.gc-point { position: absolute; width: 0; }
.gc-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #667eea; margin-left: -6rpx; }
.gc-score { display: block; font-size: 16rpx; color: #667eea; margin-left: -16rpx; margin-top: -28rpx; text-align: center; }
.gc-labels { position: relative; margin-top: 10rpx; }
.gc-label { position: absolute; font-size: 16rpx; color: #aaa; white-space: nowrap; transform: translateX(-30%); }

.warnings-list { margin: 0 24rpx; display: flex; flex-direction: column; gap: 14rpx; }
.warning-card { padding: 20rpx; border-left: 6rpx solid #f0a34b; }
.warning-card.high { border-left-color: #e85d75; background: #fff5f5; }
.warn-head { display: flex; align-items: center; }
.warn-icon { font-size: 24rpx; margin-right: 8rpx; }
.warn-dim { flex: 1; font-size: 24rpx; font-weight: 700; color: #333; }
.warn-severity { font-size: 19rpx; padding: 4rpx 14rpx; border-radius: 14rpx; }
.warn-severity.high { background: #fde8e8; color: #e85d75; }
.warn-severity.medium { background: #fef3e0; color: #f0a34b; }
.warn-scores { display: block; margin-top: 8rpx; font-size: 21rpx; color: #888; }
.warn-suggestion { display: block; margin-top: 8rpx; font-size: 21rpx; color: #666; line-height: 1.5; }

.no-warnings { margin: 0 24rpx; padding: 24rpx; text-align: center; color: #52a67a; font-size: 23rpx; }

.timeline { margin: 0 24rpx; display: flex; flex-direction: column; gap: 10rpx; }
.tl-item { padding: 18rpx 22rpx; }
.tl-head { display: flex; justify-content: space-between; align-items: center; }
.tl-date { font-size: 21rpx; color: #aaa; }
.tl-score { font-size: 24rpx; font-weight: 700; color: #e85d75; }
.tl-score.pass { color: #52a67a; }
.tl-scenario { display: block; margin-top: 6rpx; font-size: 22rpx; color: #555; }

.no-data { margin: 0 24rpx; padding: 30rpx; text-align: center; color: #aaa; font-size: 23rpx; }

.card { border-radius: 20rpx; background: #fff; box-shadow: 0 3rpx 14rpx rgba(0,0,0,.04); }
