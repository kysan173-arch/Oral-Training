.member-page { padding: 30rpx 24rpx 48rpx; }
.loading-card, .empty-card { padding: 48rpx 28rpx; color: #9198aa; font-size: 24rpx; text-align: center; }
.member-hero { display: flex; align-items: center; padding: 28rpx; margin-bottom: 18rpx; }
.hero-avatar { width: 88rpx; height: 88rpx; line-height: 88rpx; flex-shrink: 0; border-radius: 26rpx; color: #fff; background: linear-gradient(135deg, #5B6EF5, #5B6EF5); font-size: 38rpx; font-weight: 700; text-align: center; }
.hero-copy { min-width: 0; margin-left: 18rpx; }
.hero-name, .hero-meta, .hero-note { display: block; }
.hero-name { color: #3e4863; font-size: 33rpx; font-weight: 700; }
.hero-meta { margin-top: 7rpx; color: #8991a5; font-size: 21rpx; }
.hero-note { margin-top: 9rpx; color: #a4a9b8; font-size: 19rpx; line-height: 1.45; }
.stat-grid { display: flex; gap: 14rpx; margin-bottom: 28rpx; }
.stat-card { flex: 1; padding: 21rpx 7rpx; text-align: center; }
.stat-card text { display: block; }
.stat-card text:first-child { color: #5B6EF5; font-size: 34rpx; font-weight: 700; }
.stat-card text:last-child { margin-top: 6rpx; color: #7f879e; font-size: 20rpx; }
.section-heading { display: flex; justify-content: space-between; margin: 0 5rpx 14rpx; }
.section-heading text:first-child { color: #3f4860; font-size: 30rpx; font-weight: 700; }
.section-heading text:last-child { color: #a0a6b7; font-size: 20rpx; }
.radar-card { padding: 18rpx 22rpx 24rpx; margin-bottom: 28rpx; }
.dimension-row { display: flex; align-items: center; gap: 12rpx; margin-top: 15rpx; color: #687188; font-size: 21rpx; }
.dimension-row text:first-child { width: 148rpx; }
.dimension-row text:last-child { width: 42rpx; text-align: right; font-weight: 700; }
.dimension-track { height: 12rpx; flex: 1; overflow: hidden; border-radius: 8rpx; background: #eef0f5; }
.dimension-fill { height: 100%; border-radius: 8rpx; }
.weakness-card { padding: 22rpx; margin-bottom: 14rpx; border-left: 7rpx solid #e0ad54; }
.weakness-card.high { border-left-color: #df7781; }
.weakness-name { color: #505972; font-size: 26rpx; font-weight: 700; }
.weakness-score { margin-left: 12rpx; color: #8c94a9; font-size: 22rpx; }
.weakness-text { display: block; margin-top: 10rpx; color: #7c8496; font-size: 22rpx; line-height: 1.55; }
.timeline-card { padding: 8rpx 24rpx; margin-bottom: 24rpx; }
.timeline-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #eef0f5; }
.timeline-row:last-child { border-bottom: 0; }
.timeline-name, .timeline-date { display: block; }
.timeline-name { color: #566079; font-size: 24rpx; }
.timeline-date { margin-top: 5rpx; color: #a0a6b7; font-size: 20rpx; }
.timeline-score { color: #5B6EF5; font-size: 27rpx; font-weight: 700; }
