.member-page { padding: 30rpx 24rpx 48rpx; }
.loading-card, .empty-card { padding: 48rpx 28rpx; color: var(--text-secondary); font-size: 26rpx; text-align: center; }
.member-hero { display: flex; align-items: center; padding: 28rpx; margin-bottom: 18rpx; }
.hero-avatar { width: 88rpx; height: 88rpx; line-height: 88rpx; flex-shrink: 0; border-radius: 26rpx; color: #fff; background: var(--color-primary); font-size: 32rpx; font-weight: 600; text-align: center; }
.hero-copy { min-width: 0; margin-left: 18rpx; }
.hero-name, .hero-meta { display: block; }
.hero-name { color: var(--text-strong); font-size: 32rpx; font-weight: 600; }
.hero-meta { margin-top: 7rpx; color: var(--text-secondary); font-size: 22rpx; }
.stat-grid { display: flex; gap: 14rpx; margin-bottom: 28rpx; }
.stat-card { flex: 1; padding: 21rpx 7rpx; text-align: center; }
/* 四卡布局：分档均分多了一列，字号略收保持单行 */
.stat-grid-4 .stat-card text:first-child { font-size: 28rpx; }
.stat-card text { display: block; }
.stat-card text:first-child { color: var(--text-strong); font-size: 32rpx; font-weight: 600; }
.stat-card text:last-child { margin-top: 6rpx; color: var(--text-secondary); font-size: 22rpx; }

/* 进阶挑战率（P1-1） */
.tier-strip { padding: 22rpx 26rpx; margin-bottom: 28rpx; }
.tier-strip-title { display: block; color: var(--text-strong); font-size: 26rpx; font-weight: 600; }
.tier-strip-sub { display: block; margin-top: 8rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.6; }
/* 子选择器（>）限定直接子元素：折叠头里多包了一层 .section-toggle-tail，
   若沿用后代选择器，text:first-child 会把尾部计数误判成标题而放大加粗。 */
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 5rpx 14rpx; }
.section-heading > text:first-child { color: var(--text-strong); font-size: 32rpx; font-weight: 600; }
.section-heading > text:last-child { color: var(--text-muted); font-size: 22rpx; }

/* ── 可收起区块头（最近成长记录 / 训练记录抽查） ── */
/* 纵向加一点内边距，把标题行的触控热区从 ~50rpx 抬到 ~58rpx；
   不加 padding 的话这行看着像纯文字，实际很难点中。 */
.section-toggle { padding: 4rpx 0; }
.section-toggle-hover { opacity: .6; }
.section-toggle-tail { flex-shrink: 0; display: flex; align-items: center; gap: 12rpx; }
.section-toggle-tail > text { color: var(--text-muted); font-size: 22rpx; }

/* 展开指示：圆形浅底 + 纯 CSS 三角。
   不用 ▸ / ▾ 字符——那类字形粗细随字体变，部分机型还会跟基线错位，看着「脏」。 */
.toggle-badge { width: 40rpx; height: 40rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-primary-light); }
.chev { width: 0; height: 0; border-left: 8rpx solid transparent; border-right: 8rpx solid transparent; }
.chev-down { border-top: 10rpx solid var(--color-primary); }
.chev-up { border-bottom: 10rpx solid var(--color-primary); }

/* 卡片底部操作行：「还有 N 条」与「收起」共用同一套视觉（浅底胶囊），
   两者互斥出现，位置都在卡内最下方——长列表滚到底也能直接收起，不必回到顶部。 */
.list-action { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin: 14rpx 0 6rpx; padding: 16rpx; border-radius: 14rpx; background: var(--color-primary-light); color: var(--color-primary); font-size: 22rpx; }
.list-action-hover { opacity: .7; }
.dimensions-card { padding: 26rpx; margin-bottom: 28rpx; }
/* 五维横条（统一主色） */
.dimension-row { margin-bottom: 20rpx; }
.dimension-row:last-child { margin-bottom: 0; }
.dimension-head { display: flex; align-items: center; justify-content: space-between; }
.dim-name { color: var(--text-body); font-size: 26rpx; }
.dim-score { font-weight: 600; font-size: 26rpx; color: var(--text-strong); }
.score-bar { height: 13rpx; margin-top: 10rpx; overflow: hidden; border-radius: 8rpx; background: var(--color-border); }
.score-fill { height: 100%; border-radius: 8rpx; }
.fill-main { background: var(--color-primary); }
.weakness-card { padding: 22rpx; margin-bottom: 14rpx; border-left: 7rpx solid var(--color-warning); }
.weakness-card.high { border-left-color: var(--color-danger); }
.weakness-name { color: var(--text-body); font-size: 26rpx; font-weight: 600; }
.weakness-score { margin-left: 12rpx; color: var(--text-secondary); font-size: 22rpx; }
.weakness-text { display: block; margin-top: 10rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.55; }
.timeline-card { padding: 8rpx 24rpx; margin-bottom: 24rpx; }
.timeline-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid var(--color-border); }
.timeline-row:last-child { border-bottom: 0; }
.timeline-name, .timeline-date { display: block; }
.timeline-name { color: var(--text-body); font-size: 26rpx; }
/* 时间线里的进阶标记：只在「含进阶档」筛选下可见 */
.timeline-adv-tag { margin-left: 10rpx; padding: 2rpx 10rpx; border-radius: 8rpx; color: #B97A1E; background: rgba(185, 122, 30, 0.12); font-size: 20rpx; }
.timeline-date { margin-top: 5rpx; color: var(--text-muted); font-size: 22rpx; }
.timeline-score { color: var(--text-strong); font-size: 26rpx; font-weight: 600; }

/* 成长曲线 + 历史筛选 */
.chart-card { padding: 26rpx 24rpx; margin-bottom: 24rpx; }
.filter-chip-row { display: flex; flex-wrap: wrap; gap: 10rpx; padding: 6rpx 18rpx; }
.card-filter { margin: -10rpx 5rpx 14rpx; padding: 14rpx 18rpx; border-radius: 14rpx; background: var(--color-primary-light); }
/* 档位筛选与维度筛选两排相邻时补回间距：card-filter 自身的 -10rpx 上边距是为了贴紧标题，
   两排之间再叠负边距就会糊在一起。 */
.card-filter + .card-filter { margin-top: 10rpx; }
.filter-chip { padding: 8rpx 18rpx; border-radius: 18rpx; font-size: 22rpx; color: var(--color-primary); background: #fff; }
.filter-chip.selected { color: #fff; background: var(--color-primary); font-weight: 600; }

/* ── 训练记录抽查（主管质检通道） ── */
.inspect-card { padding: 8rpx 24rpx; margin-bottom: 24rpx; }
.inspect-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--color-border); }
.inspect-row:last-child { border-bottom: 0; }
.inspect-copy { flex: 1; min-width: 0; }
.inspect-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-body); font-size: 26rpx; }
.inspect-meta { display: block; margin-top: 6rpx; color: var(--text-muted); font-size: 22rpx; }
.inspect-score { flex-shrink: 0; margin: 0 14rpx; color: var(--text-strong); font-size: 26rpx; font-weight: 600; }
.inspect-arrow { flex-shrink: 0; color: var(--text-muted); font-size: 30rpx; }
