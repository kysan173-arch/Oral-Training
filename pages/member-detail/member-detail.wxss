.member-page { padding: 30rpx 24rpx 48rpx; }
.loading-card, .empty-card { padding: 48rpx 28rpx; color: var(--text-secondary); font-size: 26rpx; text-align: center; }
.member-hero { display: flex; align-items: center; padding: 28rpx; margin-bottom: 18rpx; }
.hero-avatar { width: 88rpx; height: 88rpx; line-height: 88rpx; flex-shrink: 0; border-radius: 26rpx; color: #fff; background: var(--color-primary); font-size: 32rpx; font-weight: 600; text-align: center; }
.hero-copy { min-width: 0; margin-left: 18rpx; }
.hero-name, .hero-meta, .hero-note { display: block; }
.hero-name { color: var(--text-strong); font-size: 32rpx; font-weight: 600; }
.hero-meta { margin-top: 7rpx; color: var(--text-secondary); font-size: 22rpx; }
.hero-note { margin-top: 9rpx; color: var(--text-muted); font-size: 22rpx; line-height: 1.45; }
.stat-grid { display: flex; gap: 14rpx; margin-bottom: 28rpx; }
.stat-card { flex: 1; padding: 21rpx 7rpx; text-align: center; }
.stat-card text { display: block; }
.stat-card text:first-child { color: var(--text-strong); font-size: 32rpx; font-weight: 600; }
.stat-card text:last-child { margin-top: 6rpx; color: var(--text-secondary); font-size: 22rpx; }
.section-heading { display: flex; justify-content: space-between; margin: 0 5rpx 14rpx; }
.section-heading text:first-child { color: var(--text-strong); font-size: 32rpx; font-weight: 600; }
.section-heading text:last-child { color: var(--text-muted); font-size: 22rpx; }
.dimensions-card { padding: 26rpx; margin-bottom: 28rpx; }
/* 五维横条（统一主色） */
.dimension-row { margin-bottom: 20rpx; }
.dimension-row:last-child { margin-bottom: 0; }
.dimension-head { display: flex; align-items: center; justify-content: space-between; }
.dim-name { color: var(--text-body); font-size: 26rpx; }
.dim-score { font-weight: 600; font-size: 26rpx; color: var(--text-strong); }
.score-bar { height: 13rpx; margin-top: 10rpx; overflow: hidden; border-radius: 8rpx; background: var(--color-border); }
.score-fill { height: 100%; border-radius: 8rpx; }
.fill-main { background: var(--color-primary); }
.weakness-card { padding: 22rpx; margin-bottom: 14rpx; border-left: 7rpx solid var(--color-warning); }
.weakness-card.high { border-left-color: var(--color-danger); }
.weakness-name { color: var(--text-body); font-size: 26rpx; font-weight: 600; }
.weakness-score { margin-left: 12rpx; color: var(--text-secondary); font-size: 22rpx; }
.weakness-text { display: block; margin-top: 10rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.55; }
.timeline-card { padding: 8rpx 24rpx; margin-bottom: 24rpx; }
.timeline-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid var(--color-border); }
.timeline-row:last-child { border-bottom: 0; }
.timeline-name, .timeline-date { display: block; }
.timeline-name { color: var(--text-body); font-size: 26rpx; }
.timeline-date { margin-top: 5rpx; color: var(--text-muted); font-size: 22rpx; }
.timeline-score { color: var(--text-strong); font-size: 26rpx; font-weight: 600; }
