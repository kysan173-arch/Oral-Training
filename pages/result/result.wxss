.result-page { padding-bottom: 48rpx; background: var(--bg-grad, #F7F8FA); }
.result-hero { position: relative; overflow: hidden; padding: 44rpx 24rpx 48rpx; color: #fff; text-align: center; background: linear-gradient(160deg, #5B6EF5 0%, #7A5CF0 100%); }
.hero-deco { position: absolute; border-radius: 50%; background: rgba(255,255,255,.08); }
.hero-deco-1 { width: 240rpx; height: 240rpx; right: -80rpx; top: -90rpx; }
.hero-deco-2 { width: 140rpx; height: 140rpx; left: -50rpx; bottom: -60rpx; }
.result-kicker { position: relative; display: block; color: rgba(255,255,255,.78); font-size: 23rpx; letter-spacing: 1rpx; }

/* 分数环形进度 */
.score-ring { position: relative; width: 216rpx; height: 216rpx; margin: 28rpx auto 20rpx; }
.score-ring-fill { width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 6rpx 24rpx rgba(0,0,0,.18); transition: all .4s ease; }
.score-ring-hole { position: absolute; top: 14rpx; left: 14rpx; width: 188rpx; height: 188rpx; border-radius: 50%; background: rgba(255,255,255,.96); display: flex; align-items: center; justify-content: center; }
.score-value { font-size: 66rpx; font-weight: 800; line-height: 1; transition: color .4s; }
.score-unit { margin-left: 4rpx; color: #8A93AD; font-size: 22rpx; display: flex; align-items: flex-end; }
.score-caption { position: relative; display: block; font-size: 25rpx; color: rgba(255,255,255,.92); }

.level-badge { position: relative; display: inline-flex; flex-direction: column; gap: 4rpx; padding: 10rpx 22rpx; margin-top: 16rpx; border-radius: 16rpx; color: #fff; font-size: 22rpx; font-weight: 500; }
.level-badge.excellent { background: rgba(52, 199, 89, .4); }
.level-badge.good { background: rgba(255, 255, 255, .22); }
.level-badge.qualified { background: rgba(255, 149, 0, .4); }
.level-badge.practice { background: rgba(255, 59, 48, .4); }
.level-note { color: rgba(255,255,255,.78); font-size: 19rpx; }
.result-time { position: relative; display: block; margin-top: 14rpx; color: rgba(255,255,255,.6); font-size: 20rpx; }
.notice-box { display: flex; align-items: flex-start; margin: 22rpx 24rpx 30rpx; padding: 20rpx; border-radius: 16rpx; color: #8A6E4B; background: #FFF8F0; font-size: 22rpx; line-height: 1.55; }
.notice-icon { width: 30rpx; height: 30rpx; line-height: 30rpx; flex-shrink: 0; margin-right: 12rpx; border-radius: 50%; text-align: center; color: #fff; background: #FF9500; font-size: 20rpx; }
.section-title-row { display: flex; align-items: baseline; justify-content: space-between; margin: 0 28rpx 14rpx; }
.section-title { font-size: 31rpx; font-weight: 700; color: #1A1A2E; }
.section-caption { color: #A1A1AA; font-size: 21rpx; }
.dimensions-card, .evaluation-card, .violation-card, .round-card, .phrase-card, .empty-card { padding: 26rpx; margin: 0 24rpx 26rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); }

/* 五维迷你环形 */
.dimension-rings { display: flex; justify-content: space-between; gap: 8rpx; }
.dimension-ring-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.dimension-ring-box { position: relative; width: 92rpx; height: 92rpx; }
.dimension-ring-fill { width: 100%; height: 100%; border-radius: 50%; transition: all .4s ease; }
.dimension-ring-hole { position: absolute; top: 8rpx; left: 8rpx; width: 76rpx; height: 76rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; }
.dimension-ring-score { font-size: 24rpx; font-weight: 800; color: #3d4568; line-height: 1; }
.dimension-ring-name { margin-top: 8rpx; font-size: 18rpx; color: #5a627d; text-align: center; line-height: 1.3; }
.evaluation-text { color: #6B6B7B; font-size: 26rpx; line-height: 1.7; }
.feedback-grid { display: flex; gap: 16rpx; margin: 0 24rpx 28rpx; }
.feedback-card { flex: 1; min-height: 180rpx; padding: 22rpx; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); }
.feedback-good { background: linear-gradient(160deg, #F0FBF4, #E8F8EE); border-left: 6rpx solid #34C759; }
.feedback-improve { background: linear-gradient(160deg, #FFF7EC, #FFF0DD); border-left: 6rpx solid #FF9500; }
.feedback-title { display: block; margin-bottom: 12rpx; font-size: 25rpx; font-weight: 700; }
.positive { color: #1FA250; }
.improve { color: #D97E00; }
.feedback-item { display: block; margin-top: 8rpx; color: #5E6B60; font-size: 22rpx; line-height: 1.55; }
.feedback-improve .feedback-item { color: #6B5E4A; }
.empty-card { color: #6B6B7B; font-size: 23rpx; line-height: 1.5; background: #fff; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); }
.violation-card { padding: 26rpx; margin: 0 24rpx 26rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); border-left: 6rpx solid #FF3B30; }
.violation-top { display: flex; justify-content: space-between; align-items: center; }
.violation-type { color: #FF3B30; font-size: 26rpx; font-weight: 700; }
.deduction { color: #FF3B30; font-size: 24rpx; }
.quote { display: block; margin-top: 16rpx; color: #1A1A2E; font-size: 25rpx; line-height: 1.55; font-weight: 500; }
.violation-reason { display: block; margin-top: 12rpx; color: #6B6B7B; font-size: 23rpx; line-height: 1.55; }
.rewrite-box, .round-rewrite { padding: 16rpx; margin-top: 16rpx; border-radius: 14rpx; color: #5B6EF5; background: #F2F2F7; font-size: 23rpx; line-height: 1.55; }
.rewrite-label { display: block; margin-bottom: 5rpx; color: #5B6EF5; font-size: 21rpx; font-weight: 700; }
.round-badge { display: inline-block; padding: 5rpx 16rpx; border-radius: 10rpx; background: #EEF0FF; }
.round-label { color: #5B6EF5; font-size: 22rpx; font-weight: 700; }
.round-quote { display: block; margin-top: 12rpx; color: #1A1A2E; font-size: 25rpx; line-height: 1.55; font-weight: 500; }
.round-comment { display: block; margin-top: 12rpx; color: #6B6B7B; font-size: 23rpx; line-height: 1.55; }
.phrase-patient, .phrase-copy, .phrase-reason { display: block; }
.phrase-patient { color: #FF9500; font-size: 21rpx; line-height: 1.5; }
.phrase-copy { margin-top: 10rpx; color: #5B6EF5; font-size: 25rpx; line-height: 1.6; font-weight: 500; }
.phrase-reason { margin-top: 10rpx; color: #A1A1AA; font-size: 21rpx; line-height: 1.55; }
.result-actions { padding: 0 24rpx; }
.result-actions button { width: 100%; height: 76rpx; line-height: 76rpx; margin-bottom: 16rpx; padding: 0; }
.result-btn-main { height: 84rpx !important; line-height: 84rpx !important; font-size: 29rpx !important; font-weight: 600; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1); }
.result-btn-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.result-btn-sub { flex: 1; height: 72rpx !important; line-height: 72rpx !important; font-size: 26rpx !important; background: #fff !important; border: 2rpx solid #E8E8EC !important; color: #5B6EF5 !important; }
.result-link-row { display: flex; align-items: center; justify-content: center; gap: 24rpx; padding: 16rpx 0 24rpx; }
.text-button { color: #A1A1AA; background: transparent; font-size: 24rpx; padding: 12rpx; }
.link-divider { color: #E8E8EC; font-size: 22rpx; }
.disclaimer { display: block; color: #A1A1AA; font-size: 21rpx; text-align: center; }
.loading-result { display: flex; min-height: 70vh; align-items: center; justify-content: center; background: var(--bg-grad, #F7F8FA); }
.loading-card { width: 100%; padding: 48rpx 32rpx; text-align: center; background: #fff; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); }
.loading-title { color: #1A1A2E; font-size: 31rpx; font-weight: 700; }
.loading-text { display: block; margin-top: 16rpx; color: #A1A1AA; font-size: 24rpx; line-height: 1.6; }
.retry-button { width: 100%; margin-top: 30rpx; }
