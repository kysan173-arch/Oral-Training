.result-page { padding-bottom: 48rpx; background: var(--bg-grad, var(--color-bg)); }
.result-hero { position: relative; padding: 40rpx 24rpx 44rpx; color: var(--text-strong); text-align: center; background: #fff; border-bottom: 1rpx solid var(--color-border); }
.result-kicker { position: relative; display: block; color: var(--text-secondary); font-size: 22rpx; letter-spacing: 1rpx; }

/* 分数环形进度 */
.score-ring { position: relative; width: 216rpx; height: 216rpx; margin: 28rpx auto 20rpx; }
.score-ring-fill { width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 4rpx 16rpx rgba(22, 35, 59, 0.08); transition: all .4s ease; }
.score-ring-hole { position: absolute; top: 14rpx; left: 14rpx; width: 188rpx; height: 188rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; }
.score-value { font-size: 44rpx; font-weight: 600; line-height: 1; transition: color .4s; }
.score-unit { margin-left: 4rpx; color: var(--text-muted); font-size: 22rpx; display: flex; align-items: flex-end; }
.score-caption { position: relative; display: block; font-size: 24rpx; color: var(--text-secondary); }

/* 等级徽章 + 一句话总结（白底浅色标签，弱化色块） */
.level-badge { position: relative; display: inline-block; padding: 6rpx 22rpx; margin-top: 16rpx; border-radius: 20rpx; font-size: 24rpx; font-weight: 600; }
.level-badge.excellent, .level-badge.good { color: var(--color-success); background: var(--color-success-light); }
.level-badge.qualified { color: var(--color-warning); background: var(--color-warning-light); }
.level-badge.practice { color: var(--color-danger); background: var(--color-danger-light); }
.result-summary { position: relative; display: block; max-width: 560rpx; margin: 12rpx auto 0; color: var(--text-body); font-size: 26rpx; line-height: 1.55; }
.result-time { position: relative; display: block; margin-top: 12rpx; color: var(--text-muted); font-size: 22rpx; }

/* 免责提示条（中性弱化，不占用警示语义） */
.notice-box { display: flex; align-items: flex-start; margin: 22rpx 24rpx 30rpx; padding: 20rpx; border-radius: 16rpx; color: var(--text-secondary); background: var(--color-primary-pale); font-size: 22rpx; line-height: 1.55; }
.notice-icon { width: 30rpx; height: 30rpx; line-height: 30rpx; flex-shrink: 0; margin-right: 12rpx; border-radius: 50%; text-align: center; color: var(--color-primary); background: var(--color-primary-light); font-size: 22rpx; font-weight: 600; }
.section-title-row { display: flex; align-items: baseline; justify-content: space-between; margin: 0 28rpx 14rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: var(--text-strong); }
.section-caption { color: var(--text-secondary); font-size: 22rpx; }
.dimensions-card, .violation-card, .round-card, .phrase-card, .empty-card { padding: 26rpx; margin: 0 24rpx 26rpx; background: #fff; border-radius: 20rpx; border: 1rpx solid var(--color-border); }

/* 综合评价并入五维卡底部 */
.dimension-summary { padding-top: 18rpx; margin-top: 22rpx; border-top: 1rpx dashed var(--color-border); }
.summary-label { display: block; margin-bottom: 6rpx; color: var(--text-strong); font-size: 24rpx; font-weight: 600; }
.dimension-summary > text:last-child { color: var(--text-body); font-size: 26rpx; line-height: 1.7; }

/* 折叠切换 */
.fold-toggle { padding: 4rpx 0; color: var(--color-primary); }
.fold-more { margin: -14rpx 24rpx 26rpx; padding: 18rpx 0; color: var(--color-primary); font-size: 24rpx; text-align: center; }

/* 五维横条（颜色跟随分数分档） */
.dimension-row { margin-bottom: 20rpx; }
.dimension-row:last-child { margin-bottom: 0; }
.dimension-head { display: flex; align-items: center; justify-content: space-between; }
.dim-name { color: var(--text-body); font-size: 26rpx; }
.dim-score { font-weight: 600; font-size: 26rpx; }
.score-bar { height: 13rpx; margin-top: 10rpx; overflow: hidden; border-radius: 8rpx; background: var(--color-border); }
.score-fill { height: 100%; border-radius: 8rpx; }
.fill-main { background: var(--color-primary); }
.feedback-grid { display: flex; gap: 16rpx; margin: 0 24rpx 28rpx; }
.feedback-card { flex: 1; min-height: 180rpx; padding: 22rpx; border-radius: 20rpx; display: flex; align-items: flex-start; gap: 14rpx; }
.feedback-good { background: var(--color-success-light); }
.feedback-improve { background: var(--color-warning-light); }
.feedback-icon { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-top: 2rpx; border-radius: 50%; font-size: 24rpx; font-weight: 600; }
.feedback-good .feedback-icon { color: var(--color-success); background: #fff; }
.feedback-improve .feedback-icon { color: var(--color-warning); background: #fff; }
.feedback-copy { flex: 1; min-width: 0; }
.feedback-title { display: block; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 600; }
.positive { color: var(--color-success); }
.improve { color: var(--color-warning); }
.feedback-item { display: block; margin-top: 8rpx; color: var(--text-body); font-size: 24rpx; line-height: 1.55; }
.empty-card { color: var(--text-body); font-size: 24rpx; line-height: 1.5; }
.violation-card { padding: 26rpx; margin: 0 24rpx 26rpx; background: #fff; border-radius: 20rpx; border: 1rpx solid var(--color-border); border-left: 6rpx solid var(--color-danger); }
.violation-top { display: flex; justify-content: space-between; align-items: center; }
.violation-type { color: var(--color-danger); font-size: 26rpx; font-weight: 600; }
.deduction { color: var(--color-danger); font-size: 26rpx; }
.quote { display: block; margin-top: 16rpx; color: var(--text-strong); font-size: 26rpx; line-height: 1.55; font-weight: 400; }
.violation-reason { display: block; margin-top: 12rpx; color: var(--text-body); font-size: 22rpx; line-height: 1.55; }
.rewrite-box, .round-rewrite { padding: 16rpx; margin-top: 16rpx; border-radius: 14rpx; color: var(--color-primary); background: var(--color-primary-light); font-size: 22rpx; line-height: 1.55; }
.rewrite-label { display: block; margin-bottom: 5rpx; color: var(--color-primary); font-size: 22rpx; font-weight: 600; }
.round-badge { display: inline-block; padding: 5rpx 16rpx; border-radius: 10rpx; background: var(--color-primary-light); }
.round-label { color: var(--color-primary); font-size: 22rpx; font-weight: 600; }
.round-quote { display: block; margin-top: 12rpx; color: var(--text-strong); font-size: 26rpx; line-height: 1.55; font-weight: 400; }
.round-comment { display: block; margin-top: 12rpx; color: var(--text-body); font-size: 22rpx; line-height: 1.55; }
.phrase-patient, .phrase-copy, .phrase-reason { display: block; }
.phrase-patient { color: var(--text-secondary); font-size: 22rpx; line-height: 1.5; }
.phrase-copy { margin-top: 10rpx; color: var(--color-primary); font-size: 26rpx; line-height: 1.6; font-weight: 400; }
.phrase-reason { margin-top: 10rpx; color: var(--text-secondary); font-size: 22rpx; line-height: 1.55; }
.result-actions { padding: 0 24rpx; }
.result-actions button { width: 100%; height: 76rpx; line-height: 76rpx; margin-bottom: 16rpx; padding: 0; }
.result-btn-main { height: 84rpx !important; line-height: 84rpx !important; font-size: 26rpx !important; font-weight: 600; box-shadow: 0 6rpx 18rpx rgba(22, 35, 59, 0.1); }
.result-btn-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.result-btn-sub { flex: 1; height: 72rpx !important; line-height: 72rpx !important; font-size: 26rpx !important; background: #fff !important; border: 2rpx solid var(--color-border) !important; color: var(--color-primary) !important; }
.result-link-row { display: flex; align-items: center; justify-content: center; gap: 24rpx; padding: 16rpx 0 24rpx; }
.text-button { color: var(--text-secondary); background: transparent; font-size: 26rpx; padding: 12rpx; }
.link-divider { color: var(--color-border); font-size: 22rpx; }
.disclaimer { display: block; color: var(--text-secondary); font-size: 22rpx; text-align: center; }
.loading-result { display: flex; min-height: 70vh; align-items: center; justify-content: center; background: var(--bg-grad, var(--color-bg)); }
.loading-card { width: 100%; padding: 48rpx 32rpx; text-align: center; background: #fff; border-radius: 20rpx; border: 1rpx solid var(--color-border); }
.loading-title { color: var(--text-strong); font-size: 32rpx; font-weight: 600; }
.loading-text { display: block; margin-top: 16rpx; color: var(--text-secondary); font-size: 26rpx; line-height: 1.6; }
.retry-button { width: 100%; margin-top: 30rpx; }
