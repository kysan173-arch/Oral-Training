.result-page { padding-bottom: 48rpx; }
.result-hero { padding: 38rpx 24rpx 42rpx; color: #fff; background: linear-gradient(135deg, #667eea, #764ba2); text-align: center; }
.result-kicker { display: block; color: rgba(255,255,255,.78); font-size: 23rpx; }
.score-circle { display: flex; align-items: center; justify-content: center; width: 200rpx; height: 200rpx; margin: 24rpx auto 16rpx; border: 12rpx solid rgba(255,255,255,.25); border-radius: 50%; box-sizing: border-box; }
.score-content { display: flex; align-items: baseline; justify-content: center; }
.score-value { font-size: 65rpx; font-weight: 700; }
.score-unit { margin-left: 3rpx; color: rgba(255,255,255,.75); font-size: 21rpx; }
.score-caption { display: block; font-size: 25rpx; }
.level-badge { display: inline-flex; flex-direction: column; gap: 4rpx; padding: 10rpx 20rpx; margin-top: 14rpx; border-radius: 18rpx; color: #fff; background: rgba(255,255,255,.16); font-size: 22rpx; }
.level-badge.excellent { background: rgba(77,199,149,.28); }
.level-badge.good { background: rgba(113,185,247,.26); }
.level-badge.qualified { background: rgba(239,173,75,.27); }
.level-badge.practice { background: rgba(231,124,124,.24); }
.level-note { color: rgba(255,255,255,.78); font-size: 19rpx; }
.result-time { display: block; margin-top: 12rpx; color: rgba(255,255,255,.62); font-size: 20rpx; }
.notice-box { display: flex; align-items: flex-start; margin: 22rpx 24rpx 30rpx; padding: 20rpx; border-radius: 18rpx; color: #85714f; background: #fff8e9; font-size: 22rpx; line-height: 1.55; }
.notice-icon { width: 30rpx; height: 30rpx; line-height: 30rpx; flex-shrink: 0; margin-right: 12rpx; border-radius: 50%; text-align: center; color: #fff; background: #e2ab47; font-size: 20rpx; }
.section-title-row { display: flex; align-items: baseline; justify-content: space-between; margin: 0 28rpx 14rpx; }
.section-title { font-size: 31rpx; font-weight: 700; }
.section-caption { color: #aaa; font-size: 21rpx; }
.dimensions-card, .evaluation-card, .violation-card, .round-card, .phrase-card, .empty-card { padding: 26rpx; margin: 0 24rpx 26rpx; }
.radar-card { padding: 18rpx 20rpx 22rpx; margin: 0 24rpx 28rpx; color: #9aa1b4; font-size: 20rpx; text-align: center; }
.dimension-item { margin-bottom: 22rpx; }
.dimension-item:last-child { margin-bottom: 0; }
.dimension-header { display: flex; justify-content: space-between; color: #555; font-size: 25rpx; }
.dimension-score { color: #667eea; font-weight: 700; }
.score-bar { height: 13rpx; margin-top: 11rpx; overflow: hidden; border-radius: 8rpx; background: #f0f0f4; }
.score-fill { height: 100%; border-radius: 8rpx; }
.evaluation-text { color: #555; font-size: 26rpx; line-height: 1.7; }
.feedback-grid { display: flex; gap: 16rpx; margin: 0 24rpx 28rpx; }
.feedback-card { flex: 1; min-height: 180rpx; padding: 22rpx; }
.feedback-title { display: block; margin-bottom: 12rpx; font-size: 25rpx; font-weight: 700; }
.positive { color: #3a9a69; }
.improve { color: #bd7a35; }
.feedback-item { display: block; margin-top: 8rpx; color: #777; font-size: 22rpx; line-height: 1.55; }
.empty-card { color: #777; font-size: 23rpx; line-height: 1.5; }
.violation-top { display: flex; justify-content: space-between; align-items: center; }
.violation-type { color: #d26464; font-size: 26rpx; font-weight: 700; }
.deduction { color: #d26464; font-size: 24rpx; }
.quote { display: block; margin-top: 16rpx; color: #555; font-size: 25rpx; line-height: 1.55; }
.violation-reason { display: block; margin-top: 12rpx; color: #888; font-size: 23rpx; line-height: 1.55; }
.rewrite-box, .round-rewrite { padding: 16rpx; margin-top: 16rpx; border-radius: 14rpx; color: #5672bd; background: #f4f6ff; font-size: 23rpx; line-height: 1.55; }
.rewrite-label { display: block; margin-bottom: 5rpx; color: #667eea; font-size: 21rpx; font-weight: 700; }
.round-label { color: #667eea; font-size: 22rpx; font-weight: 700; }
.round-quote { display: block; margin-top: 12rpx; color: #555; font-size: 25rpx; line-height: 1.55; }
.round-comment { display: block; margin-top: 12rpx; color: #888; font-size: 23rpx; line-height: 1.55; }
.phrase-patient, .phrase-copy, .phrase-reason { display: block; }
.phrase-patient { color: #a57738; font-size: 21rpx; line-height: 1.5; }
.phrase-copy { margin-top: 10rpx; color: #4c609b; font-size: 25rpx; line-height: 1.6; }
.phrase-reason { margin-top: 10rpx; color: #999; font-size: 21rpx; line-height: 1.55; }
.result-actions { padding: 0 24rpx; }
.result-actions button { width: 100%; height: 76rpx; line-height: 76rpx; margin-bottom: 16rpx; padding: 0; }
.text-button { color: #667eea; background: transparent; font-size: 25rpx; }
.disclaimer { display: block; color: #aaa; font-size: 21rpx; text-align: center; }
.loading-result { display: flex; min-height: 70vh; align-items: center; justify-content: center; }
.loading-card { width: 100%; padding: 48rpx 32rpx; text-align: center; }
.loading-title, .loading-text { display: block; }
.loading-title { color: #333; font-size: 31rpx; font-weight: 700; }
.loading-text { margin-top: 16rpx; color: #999; font-size: 24rpx; line-height: 1.6; }
.retry-button { width: 100%; margin-top: 30rpx; }
