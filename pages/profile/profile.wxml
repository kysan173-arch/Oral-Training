<view class="page-shell profile-page">
  <!-- 骨架加载 -->
  <view class="skeleton-block" wx:if="{{loading}}">
    <view class="skeleton-hero"></view>
    <view class="skeleton-stats">
      <view class="skeleton-stat"></view>
      <view class="skeleton-stat"></view>
      <view class="skeleton-stat"></view>
    </view>
    <view class="skeleton-row-short"></view>
    <view class="skeleton-bars">
      <view class="skeleton-bar"></view>
      <view class="skeleton-bar"></view>
      <view class="skeleton-bar"></view>
      <view class="skeleton-bar"></view>
      <view class="skeleton-bar"></view>
    </view>
    <view class="skeleton-row"></view>
    <view class="skeleton-row"></view>
  </view>

  <block wx:elif="{{profile}}">
    <!-- 页头 -->
    <view class="profile-header">
      <text class="page-title">个人成长</text>
      <text class="page-intro">你的数据仅基于本人完成的客服训练报告，用于回顾练习重点，不用于排名或正式考核。</text>
    </view>

    <!-- 统计卡 横滑 -->
    <scroll-view class="stat-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="stat-row">
        <view class="stat-card">
          <view class="stat-icon"><image class="stat-icon-img" src="/static/image/data/sessions.png" mode="aspectFit"></image></view>
          <text class="stat-val">{{profile.overall.totalCompleted}}</text>
          <text class="stat-lbl">完成训练</text>
        </view>
        <view class="stat-card">
          <view class="stat-icon"><image class="stat-icon-img" src="/static/image/data/score.png" mode="aspectFit"></image></view>
          <text class="stat-val">{{profile.overall.averageScore}}</text>
          <text class="stat-lbl">平均得分</text>
        </view>
        <view class="stat-card stat-card-delta {{profile.overall.scoreDelta > 0 ? 'delta-positive' : profile.overall.scoreDelta < 0 ? 'delta-negative' : ''}}">
          <view class="stat-icon"><image class="stat-icon-img" src="/static/image/tools/growth.png" mode="aspectFit"></image></view>
          <text class="stat-val">{{profile.overall.scoreDelta > 0 ? '+' : ''}}{{profile.overall.scoreDelta}}</text>
          <text class="stat-lbl">首末变化</text>
        </view>
      </view>
    </scroll-view>

    <!-- 能力画像 -->
    <view class="section-heading"><text>能力画像</text></view>
    <view class="dimension-card card">
      <view class="dimension-row" wx:for="{{dimensions}}" wx:key="key">
        <view class="dimension-head">
          <text class="dim-name">{{item.name}}</text>
          <view class="dimension-head-right">
            <text class="dim-tag" wx:if="{{item.weakest}}">待提升</text>
            <text class="dim-score">{{item.score}}</text>
          </view>
        </view>
        <view class="score-bar">
          <view class="score-fill {{item.weakest ? 'fill-weak' : 'fill-main'}}" style="width: {{item.score}}%;"></view>
        </view>
      </view>
    </view>

    <!-- 下一步练习重点 -->
    <view class="section-heading"><text>下一步练习重点</text></view>
    <view class="weakness-card card" wx:for="{{weaknesses}}" wx:key="key">
      <view class="weakness-head">
        <text class="weakness-tag">优先提升</text>
        <text>{{item.name}}</text>
        <text class="weakness-score">{{item.score}} 分</text>
      </view>
      <text class="weakness-body">{{item.suggestion}}</text>
    </view>

    <!-- 错题掌握进度 -->
    <view class="learning-summary card">
      <view class="ls-header">
        <text class="ls-title">错题掌握进度</text>
        <text class="ls-link" bindtap="goMistakes">去复练 ›</text>
      </view>
      <text class="ls-stats">{{profile.mistakes.mastered}} / {{profile.mistakes.total}} 项已标记掌握</text>
      <view class="ls-bar">
        <view class="ls-fill" style="width: {{mistakePercent}}%;"></view>
      </view>
    </view>

    <!-- 最近训练走势 -->
    <view class="section-heading">
      <text>最近训练走势</text>
      <text class="section-link" bindtap="goHistory">历史记录 ›</text>
    </view>
    <view class="empty-card card" wx:if="{{trend.length === 0}}"><text>完成一次客服训练后，这里会出现真实的成长记录。</text></view>
    <view class="trend-card card" wx:for="{{trend}}" wx:key="sessionId">
      <view class="trend-left">
        <text class="trend-scene">{{item.scenarioName}}</text>
        <text class="trend-date">{{item.date}}</text>
      </view>
      <view class="trend-right">
        <text class="trend-score tier-{{item.tier}}">{{item.scoreLabel}}</text>
        <text wx:if="{{item.arrow}}" class="trend-arrow arrow-{{item.arrowClass}}">{{item.arrow}}</text>
      </view>
    </view>

    <!-- 底部操作 -->
    <button class="primary-button train-button" bindtap="goTraining">开始下一次训练</button>
    <view class="aux-links">
      <view class="aux-link" bindtap="goPhrases"><image class="aux-link-img" src="/static/image/tools/phrase.png" mode="aspectFit"></image><text>话术锦囊 ›</text></view>
      <view class="aux-link" bindtap="goMistakes"><image class="aux-link-img" src="/static/image/tools/mistake.png" mode="aspectFit"></image><text>错题复练 ›</text></view>
    </view>
  </block>
</view>
