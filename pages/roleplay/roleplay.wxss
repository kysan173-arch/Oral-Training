.roleplay-page { display: flex; flex-direction: column; height: 100vh; padding-bottom: 0; box-sizing: border-box; background: var(--bg-grad, #F7F9FC); }
.roleplay-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx 20rpx; color: var(--text-strong); background: #fff; border-bottom: 1rpx solid var(--color-border); }
.customer-title { display: flex; align-items: center; }
.customer-dot { width: 64rpx; height: 64rpx; margin-right: 16rpx; border-radius: 18rpx; background: var(--color-primary-light); }
.customer-name-row { display: flex; align-items: center; gap: 10rpx; }
.customer-name, .customer-subtitle { display: block; }
.customer-name { font-size: 32rpx; font-weight: 600; color: var(--text-strong); }
.mode-badge { display: inline-flex; align-items: center; padding: 3rpx 14rpx; border-radius: 12rpx; color: var(--color-primary); background: var(--color-primary-light); font-size: 20rpx; font-weight: 600; }
.customer-subtitle { max-width: 430rpx; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-secondary); font-size: 22rpx; }
.round-counter { display: flex; align-items: baseline; padding: 10rpx 14rpx; border-radius: 16rpx; background: var(--color-primary-light); }
.round-value { font-size: 32rpx; font-weight: 600; color: var(--color-primary); }
.round-total { margin-left: 4rpx; color: var(--text-secondary); font-size: 22rpx; }
.profile-strip { display: flex; align-items: center; padding: 16rpx 28rpx; background: #fff; border-bottom: 1rpx solid var(--color-border); }
.strip-label { padding: 5rpx 12rpx; border-radius: 14rpx; color: var(--color-primary); background: var(--color-primary-light); font-size: 22rpx; }
.strip-text { flex: 1; margin-left: 14rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #777; font-size: 22rpx; }
.chat-area { flex: 1; min-height: 0; padding: 22rpx 24rpx; box-sizing: border-box; }
.chat-intro { padding: 16rpx 20rpx; margin-bottom: 16rpx; border-radius: 16rpx; color: #777; background: #fff; font-size: 22rpx; line-height: 1.5; text-align: center; }
.suggestion-panel { padding: 18rpx; margin-bottom: 22rpx; border-radius: 16rpx; background: var(--color-primary-light); }
.suggestion-title { display: block; color: var(--color-primary); font-size: 22rpx; font-weight: 600; }
.suggestion-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.suggestion-chip { padding: 9rpx 13rpx; border-radius: 15rpx; color: var(--color-primary); background: #fff; font-size: 22rpx; line-height: 1.45; }
.message-item { display: flex; align-items: flex-start; margin-bottom: 26rpx; }
.learner-message { flex-direction: row-reverse; }
.message-avatar { width: 58rpx; height: 58rpx; line-height: 58rpx; flex-shrink: 0; border-radius: 18rpx; color: var(--color-primary); background: var(--color-primary-light); font-size: 22rpx; text-align: center; }
.learner-message .message-avatar { color: #fff; background: var(--color-primary); }
.message-body { max-width: 78%; margin-left: 14rpx; }
.learner-message .message-body { margin-right: 14rpx; margin-left: 0; }
.message-role { display: block; margin-bottom: 7rpx; color: var(--text-secondary); font-size: 22rpx; }
.learner-message .message-role { text-align: right; }
.message-bubble { padding: 18rpx 22rpx; border-radius: 6rpx 22rpx 22rpx 22rpx; color: var(--text-body); background: #fff; border: 1rpx solid var(--color-border); font-size: 28rpx; line-height: 1.6; }
.learner-message .message-bubble { border-radius: 22rpx 6rpx 22rpx 22rpx; color: #fff; background: var(--color-primary); }
.learning-card { padding: 16rpx; margin-top: 10rpx; border-radius: 14rpx; background: var(--color-primary-light); }
.learning-title { display: block; color: var(--color-primary); font-size: 22rpx; font-weight: 600; }
.learning-point { display: block; margin-top: 7rpx; color: var(--text-body); font-size: 22rpx; line-height: 1.5; }
.boundary-box { padding-top: 12rpx; margin-top: 12rpx; border-top: 1rpx solid var(--color-border); color: #8A6E4B; font-size: 22rpx; line-height: 1.5; }
.boundary-label { margin-right: 10rpx; color: var(--color-warning); font-weight: 600; }
.typing { display: flex; align-items: center; width: max-content; padding: 15rpx 20rpx; margin: 4rpx 0 20rpx 72rpx; border-radius: 18rpx; color: var(--text-secondary); background: #fff; font-size: 22rpx; }
.typing-dot { width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: var(--color-primary); }
.training-note { padding: 10rpx 24rpx; color: var(--text-secondary); background: var(--bg-grad, var(--color-bg)); font-size: 22rpx; text-align: center; }
.input-area { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 22rpx; background: #fff; border-top: 1rpx solid var(--color-border); }
.input-field { flex: 1; height: 72rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 36rpx; background: var(--color-bg); font-size: 26rpx; }
.send-button { width: 128rpx; height: 72rpx; line-height: 72rpx; padding: 0; border-radius: 36rpx; color: #fff; background: var(--color-primary); font-size: 26rpx; }
.send-button[disabled] { background: var(--color-border); }
.roleplay-footer { display: flex; flex-direction: column; align-items: center; padding: 14rpx 22rpx 22rpx; background: #fff; }
.leave-link { padding: 12rpx 8rpx 0; color: var(--text-secondary); font-size: 22rpx; }
.finish-button { width: 300rpx; height: 64rpx; line-height: 64rpx; padding: 0; border: 1rpx solid var(--color-border); border-radius: 32rpx; color: var(--color-primary); background: var(--color-primary-light); font-size: 26rpx; text-align: center; font-weight: 600; }
.finish-button.is-disabled { color: var(--text-muted); border-color: var(--color-border); background: var(--color-bg); }
