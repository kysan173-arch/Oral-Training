<view class="page-shell admin-page">
  <view class="admin-header">
    <text class="eyebrow">数据 · 主管看板</text>
    <text class="page-title">团队管理</text>
  </view>

  <!-- Tab 切换 -->
  <scroll-view class="tab-scroll" scroll-x>
    <view class="tab-row">
      <view class="tab-item {{activeTab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="onTabTap">概览</view>
      <view class="tab-item {{activeTab === 'trend' ? 'active' : ''}}" data-tab="trend" bindtap="onTabTap">趋势</view>
      <view class="tab-item {{activeTab === 'members' ? 'active' : ''}}" data-tab="members" bindtap="onTabTap">成员</view>
      <view class="tab-item {{activeTab === 'warnings' ? 'active' : ''}}" data-tab="warnings" bindtap="onTabTap">预警</view>
      <view class="tab-item {{activeTab === 'plans' ? 'active' : ''}}" data-tab="plans" bindtap="onTabTap">计划</view>
      <view class="tab-item {{activeTab === 'violations' ? 'active' : ''}}" data-tab="violations" bindtap="onTabTap">违规</view>
      <view class="tab-item {{activeTab === 'leaderboard' ? 'active' : ''}}" data-tab="leaderboard" bindtap="onTabTap">排行</view>
    </view>
  </scroll-view>

  <!-- ======================== 1. 概览 ======================== -->
  <view class="tab-content" wx:if="{{activeTab === 'overview'}}">
    <!-- 时间筛选 -->
    <view class="time-filters">
      <text class="tf-item {{timeRange === 'week' ? 'active' : ''}}" data-range="week" bindtap="onTimeRange">本周</text>
      <text class="tf-item {{timeRange === 'month' ? 'active' : ''}}" data-range="month" bindtap="onTimeRange">本月</text>
      <text class="tf-item {{timeRange === 'quarter' ? 'active' : ''}}" data-range="quarter" bindtap="onTimeRange">本季度</text>
      <text class="tf-item {{timeRange === 'all' ? 'active' : ''}}" data-range="all" bindtap="onTimeRange">全部</text>
    </view>

    <!-- 核心指标 -->
    <view class="summary-cards" wx:if="{{dashboard}}">
      <view class="summary-card card"><text class="sum-val">{{dashboard.studentCount}}</text><text class="sum-label">学员数</text></view>
      <view class="summary-card card"><text class="sum-val">{{dashboard.totalSessions}}</text><text class="sum-label">总训练</text></view>
      <view class="summary-card card"><text class="sum-val">{{dashboard.averageScore}}</text><text class="sum-label">均分</text></view>
      <view class="summary-card card"><text class="sum-val">{{dashboard.teamPassRate}}%</text><text class="sum-label">通关率</text></view>
    </view>
    <view class="loading-block" wx:elif="{{loadingOverview}}"><text>加载中...</text></view>

    <!-- 五维平均 -->
    <view class="section-header"><text class="section-title">五维平均得分</text></view>
    <view class="dimension-card card" wx:if="{{dashboard}}">
      <view class="dim-row" wx:for="{{dimKeys}}" wx:key="*this" wx:for-item="k">
        <view class="dim-head">
          <text>{{k === 'knowledgeAccuracy' ? '知识准确性' : k === 'medicalCompliance' ? '医疗合规' : k === 'empathy' ? '同理心' : k === 'needsDiscovery' ? '需求挖掘' : '服务礼仪'}}</text>
          <text class="dim-score">{{dashboard.dimensionAverages[k] || 0}}</text>
        </view>
        <view class="dim-bar"><view class="dim-fill" style="width:{{dashboard.dimensionAverages[k] || 0}}%;"></view></view>
      </view>
    </view>

    <!-- 场景通过率分布 -->
    <view class="section-header"><text class="section-title">场景通过率分布</text><text class="section-sub">标注薄弱场景</text></view>
    <view class="scene-pass-card card" wx:if="{{dashboard && dashboard.scenarioPassRates}}">
      <view class="sp-row" wx:for="{{dashboard.scenarioPassRates}}" wx:key="scenarioId">
        <view class="sp-head">
          <text class="sp-name">{{item.name}}</text>
          <text class="sp-count">{{item.total}}次 · 均{{item.avgScore}}分</text>
        </view>
        <view class="sp-bar-wrap">
          <view class="sp-bar" style="width:{{item.passRate}}%; background:{{item.passRate < 50 ? '#e85d75' : item.passRate < 70 ? '#f0a34b' : '#52a67a'}};"></view>
          <text class="sp-rate" style="left:{{item.passRate}}%; color:{{item.passRate < 50 ? '#e85d75' : item.passRate < 70 ? '#f0a34b' : '#52a67a'}};">{{item.passRate}}%</text>
        </view>
        <text class="sp-warning" wx:if="{{item.passRate < 50}}">⚠ 薄弱场景</text>
        <text class="sp-warning warn-low" wx:elif="{{item.passRate < 70}}">⚡ 需关注</text>
      </view>
    </view>

    <!-- 辅导建议 -->
    <view class="section-header"><text class="section-title">辅导建议</text><text class="section-sub">AI 自动生成</text></view>
    <view class="coaching-list" wx:if="{{dashboard && dashboard.coachingSuggestions && dashboard.coachingSuggestions.length > 0}}">
      <view class="coaching-card card {{item.severity === 'high' ? 'high' : ''}}" wx:for="{{dashboard.coachingSuggestions}}" wx:key="title">
        <view class="coach-head">
          <text class="coach-icon">{{item.icon}}</text>
          <text class="coach-title">{{item.title}}</text>
        </view>
        <text class="coach-desc">{{item.description}}</text>
      </view>
    </view>
    <view class="no-data card" wx:elif="{{dashboard}}"><text>✅ 团队各项指标表现良好，暂无特别建议</text></view>

    <!-- 最近训练 -->
    <view class="section-header"><text class="section-title">最近训练</text></view>
    <view class="recent-list card" wx:if="{{dashboard && dashboard.recentSessions}}">
      <view class="recent-row" wx:for="{{dashboard.recentSessions}}" wx:key="id">
        <view class="rec-info"><text class="rec-member">{{item.memberName || '匿名'}}</text><text class="rec-scene">{{item.scenarioName}}</text></view>
        <text class="rec-score {{item.totalScore >= 60 ? 'pass' : ''}}">{{item.totalScore}}分</text>
      </view>
      <view class="no-recent" wx:if="{{dashboard.recentSessions.length === 0}}"><text>暂无训练记录</text></view>
    </view>
  </view>

  <!-- ======================== 2. 趋势 ======================== -->
  <view class="tab-content" wx:if="{{activeTab === 'trend'}}">
    <view class="time-filters">
      <text class="tf-item {{trendTimeRange === 'week' ? 'active' : ''}}" data-range="week" bindtap="onTrendTime">周</text>
      <text class="tf-item {{trendTimeRange === 'month' ? 'active' : ''}}" data-range="month" bindtap="onTrendTime">月</text>
      <text class="tf-item {{trendTimeRange === 'quarter' ? 'active' : ''}}" data-range="quarter" bindtap="onTrendTime">季度</text>
    </view>
    <view class="chart-card card">
      <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
      <view class="chart-legend">
        <view class="cl-item"><view class="cl-dot" style="background:rgba(102,126,234,.3);"></view><text>训练次数（柱）</text></view>
        <view class="cl-item"><view class="cl-dot" style="background:#e85d75;"></view><text>平均分（线）</text></view>
      </view>
    </view>
    <view class="trend-table card">
      <view class="trend-tr head">
        <text class="trend-td">日期</text><text class="trend-td">次数</text><text class="trend-td">均分</text>
      </view>
      <view class="trend-tr" wx:for="{{trendData}}" wx:key="date">
        <text class="trend-td date">{{item.date.slice(5)}}</text>
        <text class="trend-td">{{item.count}}</text>
        <text class="trend-td score">{{item.avgScore}}</text>
      </view>
    </view>
  </view>

  <!-- ======================== 3. 成员列表 ======================== -->
  <view class="tab-content" wx:if="{{activeTab === 'members'}}">
    <!-- 排序/筛选 -->
    <view class="filter-row">
      <view class="sort-btns">
        <text class="sb-item {{memberSortBy === 'score' ? 'active' : ''}}" data-sort="score" bindtap="onMemberSort">按均分</text>
        <text class="sb-item {{memberSortBy === 'total' ? 'active' : ''}}" data-sort="total" bindtap="onMemberSort">按次数</text>
        <text class="sb-item {{memberSortBy === 'hours' ? 'active' : ''}}" data-sort="hours" bindtap="onMemberSort">按工时</text>
      </view>
      <view class="level-filters">
        <text class="lf-item {{memberFilterLevel === '' ? 'active' : ''}}" data-level="" bindtap="onMemberFilter">全部</text>
        <text class="lf-item {{memberFilterLevel === '专家' ? 'active' : ''}}" data-level="专家" bindtap="onMemberFilter">专家</text>
        <text class="lf-item {{memberFilterLevel === '优秀' ? 'active' : ''}}" data-level="优秀" bindtap="onMemberFilter">优秀</text>
        <text class="lf-item {{memberFilterLevel === '新手' ? 'active' : ''}}" data-level="新手" bindtap="onMemberFilter">新手</text>
      </view>
    </view>

    <view class="member-list">
      <view class="member-card card" wx:for="{{members}}" wx:key="id" data-id="{{item.id}}" bindtap="goMemberDetail">
        <view class="mc-avatar">{{item.avatar}}</view>
        <view class="mc-info">
          <text class="mc-name">{{item.name}}</text>
          <text class="mc-role">{{item.role}} · {{item.level}}</text>
        </view>
        <view class="mc-stats">
          <text class="mc-score">{{item.avgScore}}分</text>
          <text class="mc-pass">{{item.passRate}}%通过</text>
          <text class="mc-total">{{item.completedTrainings}}/{{item.totalTrainings}}次</text>
        </view>
        <text class="mc-active" wx:if="{{item.hasActive}}">训练中</text>
        <text class="mc-arrow">›</text>
      </view>
      <view class="no-data card" wx:if="{{members.length === 0}}"><text>暂无成员数据</text></view>
    </view>
  </view>

  <!-- ======================== 4. 预警 ======================== -->
  <view class="tab-content" wx:if="{{activeTab === 'warnings'}}">
    <view class="section-header"><text class="section-title">团队维度预警</text></view>
    <view class="warn-list" wx:if="{{teamWarnings.length > 0}}">
      <view class="warn-card card {{item.severity === 'high' ? 'high' : ''}}" wx:for="{{teamWarnings}}" wx:key="dimension">
        <text class="warn-icon">⚠️</text>
        <view class="warn-text"><text class="warn-name">{{item.dimensionName}}维度</text><text class="warn-desc">团队均 {{item.avgScore}}分，{{item.severity === 'high' ? '需重点关注' : '建议加强训练'}}</text></view>
      </view>
    </view>
    <view class="no-data card" wx:else><text>✅ 各维度表现良好</text></view>

    <view class="section-header"><text class="section-title">个人薄弱项</text></view>
    <view class="member-warn-list">
      <view class="mw-card card" wx:for="{{memberWarnings}}" wx:key="memberId">
        <view class="mw-head">
          <text class="mw-avatar">{{item.memberAvatar}}</text>
          <text class="mw-name">{{item.memberName}} · 均{{item.avgScore}}分</text>
        </view>
        <view class="mw-alert" wx:for="{{item.alerts}}" wx:key="dimension" wx:for-item="a">
          <text class="mwa-dim">{{a.dimensionName}}:</text>
          <text class="mwa-score">连续低分 {{a.scores}}</text>
        </view>
      </view>
      <view class="no-data card" wx:if="{{memberWarnings.length === 0}}"><text>🎉 全员近期表现稳定</text></view>
    </view>
  </view>

  <!-- ======================== 5. 培训计划 ======================== -->
  <view class="tab-content" wx:if="{{activeTab === 'plans'}}">
    <view class="plan-actions">
      <button class="btn-add" bindtap="togglePlanForm">{{showPlanForm ? '取消' : '+ 新建计划'}}</button>
    </view>

    <!-- 新建计划表单 -->
    <view class="form-card card" wx:if="{{showPlanForm}}">
      <text class="form-label">计划标题</text>
      <input class="form-input" value="{{planForm.title}}" bindinput="onPlanTitleInput" placeholder="例如：3月合规专项训练" />
      <text class="form-label">描述</text>
      <textarea class="form-textarea" value="{{planForm.description}}" bindinput="onPlanDescInput" placeholder="计划目标与要求..." />
      <text class="form-label">参与成员</text>
      <view class="form-chips">
        <text class="chip {{planForm.targetMemberIds.indexOf('demo-user-001') >= 0 ? 'active' : ''}}" data-id="demo-user-001" bindtap="togglePlanMember">张顾问</text>
        <text class="chip {{planForm.targetMemberIds.indexOf('user-002') >= 0 ? 'active' : ''}}" data-id="user-002" bindtap="togglePlanMember">李顾问</text>
        <text class="chip {{planForm.targetMemberIds.indexOf('user-003') >= 0 ? 'active' : ''}}" data-id="user-003" bindtap="togglePlanMember">王顾问</text>
        <text class="chip {{planForm.targetMemberIds.indexOf('user-004') >= 0 ? 'active' : ''}}" data-id="user-004" bindtap="togglePlanMember">赵顾问</text>
        <text class="chip {{planForm.targetMemberIds.indexOf('user-005') >= 0 ? 'active' : ''}}" data-id="user-005" bindtap="togglePlanMember">陈顾问</text>
      </view>
      <text class="form-label">重点维度</text>
      <view class="form-chips">
        <text class="chip {{planForm.focusDimensions.indexOf('knowledgeAccuracy') >= 0 ? 'active' : ''}}" data-dim="knowledgeAccuracy" bindtap="togglePlanDim">知识准确性</text>
        <text class="chip {{planForm.focusDimensions.indexOf('medicalCompliance') >= 0 ? 'active' : ''}}" data-dim="medicalCompliance" bindtap="togglePlanDim">医疗合规</text>
        <text class="chip {{planForm.focusDimensions.indexOf('empathy') >= 0 ? 'active' : ''}}" data-dim="empathy" bindtap="togglePlanDim">同理心</text>
        <text class="chip {{planForm.focusDimensions.indexOf('needsDiscovery') >= 0 ? 'active' : ''}}" data-dim="needsDiscovery" bindtap="togglePlanDim">需求挖掘</text>
        <text class="chip {{planForm.focusDimensions.indexOf('serviceEtiquette') >= 0 ? 'active' : ''}}" data-dim="serviceEtiquette" bindtap="togglePlanDim">服务礼仪</text>
      </view>
      <button class="btn-submit" bindtap="submitPlan">提交计划</button>
    </view>

    <!-- 计划列表 -->
    <view class="plan-list">
      <view class="plan-card card" wx:for="{{plans}}" wx:key="id">
        <view class="pl-head" data-id="{{item.id}}" bindtap="togglePlanExpand">
          <view class="pl-info">
            <text class="pl-title">{{item.title}}</text>
            <text class="pl-meta">{{item.targetMemberIds.length}}人 · 任务 {{item.completedTaskCount}}/{{item.taskCount}} · {{item.status === 'active' ? '进行中' : '已完成'}}</text>
          </view>
          <view class="pl-actions">
            <text class="pl-action" data-plan-id="{{item.id}}" bindtap="toggleTaskForm" catchtap="toggleTaskForm">+任务</text>
            <text class="pl-action del" data-id="{{item.id}}" bindtap="deletePlan" catchtap="deletePlan">删除</text>
          </view>
        </view>

        <!-- 任务列表 -->
        <view class="task-list" wx:if="{{planExpandedId === item.id}}">
          <view class="task-row {{t.status === 'done' ? 'done' : ''}}" wx:for="{{item.tasks}}" wx:key="id" wx:for-item="t">
            <view class="tk-check" data-plan-id="{{item.id}}" data-task-id="{{t.id}}" data-status="{{t.status}}" bindtap="toggleTaskDone">{{t.status === 'done' ? '✅' : '⬜'}}</view>
            <text class="tk-title">{{t.title}}</text>
            <text class="tk-due" wx:if="{{t.dueDate}}">{{t.dueDate}}</text>
          </view>
          <view class="no-tasks" wx:if="{{!item.tasks || item.tasks.length === 0}}"><text>暂无任务，点击"+任务"添加</text></view>
        </view>
      </view>
      <view class="no-data card" wx:if="{{plans.length === 0 && !showPlanForm}}"><text>暂无培训计划</text></view>
    </view>

    <!-- 任务表单弹层 -->
    <view class="modal-mask" wx:if="{{showTaskForm}}" bindtap="toggleTaskForm">
      <view class="modal-card card" catchtap="">
        <text class="form-label">任务标题</text>
        <input class="form-input" value="{{taskForm.title}}" bindinput="onTaskTitleInput" placeholder="例如：完成种植牙场景训练" />
        <text class="form-label">负责人</text>
        <view class="form-chips">
          <text class="chip {{taskForm.assigneeId === 'demo-user-001' ? 'active' : ''}}" data-id="demo-user-001" bindtap="onTaskAssignee">张顾问</text>
          <text class="chip {{taskForm.assigneeId === 'user-002' ? 'active' : ''}}" data-id="user-002" bindtap="onTaskAssignee">李顾问</text>
          <text class="chip {{taskForm.assigneeId === 'user-003' ? 'active' : ''}}" data-id="user-003" bindtap="onTaskAssignee">王顾问</text>
          <text class="chip {{taskForm.assigneeId === 'user-004' ? 'active' : ''}}" data-id="user-004" bindtap="onTaskAssignee">赵顾问</text>
          <text class="chip {{taskForm.assigneeId === 'user-005' ? 'active' : ''}}" data-id="user-005" bindtap="onTaskAssignee">陈顾问</text>
        </view>
        <button class="btn-submit" bindtap="submitTask">添加任务</button>
      </view>
    </view>
  </view>

  <!-- ======================== 6. 高频违规 ======================== -->
  <view class="tab-content" wx:if="{{activeTab === 'violations'}}">
    <view class="section-header"><text class="section-title">违规类型分布</text></view>
    <view class="vio-types card" wx:if="{{violationTypes.length > 0}}">
      <view class="vt-row" wx:for="{{violationTypes}}" wx:key="type">
        <text class="vt-type">{{item.type}}</text>
        <text class="vt-count">{{item.count}}次</text>
      </view>
    </view>

    <view class="section-header"><text class="section-title">高频违规词汇</text></view>
    <view class="vio-words card" wx:if="{{violationWords.length > 0}}">
      <view class="vw-tags">
        <text class="vw-tag" wx:for="{{violationWords}}" wx:key="word" wx:for-item="w" style="font-size:{{14 + w.count * 2 > 34 ? 34 : 14 + w.count * 2}}rpx; opacity:{{0.4 + (w.count / violationWords[0].count) * 0.6}};">{{w.word}}({{w.count}})</text>
      </view>
    </view>
    <view class="no-data card" wx:if="{{violationWords.length === 0}}"><text>暂无违规数据</text></view>
  </view>

  <!-- ======================== 7. 排行榜 ======================== -->
  <view class="tab-content" wx:if="{{activeTab === 'leaderboard'}}">
    <view class="sort-btns">
      <text class="sb-item {{lbSortBy === 'score' ? 'active' : ''}}" data-sort="score" bindtap="onLbSort">按均分</text>
      <text class="sb-item {{lbSortBy === 'count' ? 'active' : ''}}" data-sort="count" bindtap="onLbSort">按次数</text>
      <text class="sb-item {{lbSortBy === 'pass' ? 'active' : ''}}" data-sort="pass" bindtap="onLbSort">按通过率</text>
      <text class="sb-item {{lbSortBy === 'hours' ? 'active' : ''}}" data-sort="hours" bindtap="onLbSort">按工时</text>
    </view>

    <view class="lb-list">
      <view class="lb-card card" wx:for="{{leaderboard}}" wx:key="id">
        <view class="lb-rank {{item.rank <= 3 ? 'top-' + item.rank : ''}}">{{item.rank <= 3 ? ['🥇','🥈','🥉'][item.rank-1] : item.rank}}</view>
        <text class="lb-avatar">{{item.avatar}}</text>
        <view class="lb-info">
          <text class="lb-name">{{item.name}}</text>
          <text class="lb-role">{{item.role}}</text>
        </view>
        <view class="lb-scores">
          <text class="lb-main">{{item.avgScore}}分</text>
          <text class="lb-sub">{{item.completedCount}}次 · {{item.passRate}}%</text>
        </view>
      </view>
    </view>

    <!-- 导出 -->
    <view class="export-section">
      <button class="btn-export" bindtap="doExport">导出 CSV 报表</button>
    </view>
  </view>

  <text class="disclaimer">数据来自团队训练记录，仅作培训参考。</text>
</view>
