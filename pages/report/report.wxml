<view class="page-shell history-page">
  <view class="admin-blocked-card" wx:if="{{roleBlocked}}">
    <text class="admin-blocked-icon">主管</text>
    <text class="admin-blocked-title">训练历史为学员功能</text>
    <text class="admin-blocked-desc">主管可通过数据看板查看所有学员的训练记录与详情</text>
    <view class="admin-blocked-btn" bindtap="goAdminDashboard">前往数据看板</view>
  </view>
  <block wx:else>
  <view class="history-header"><text class="eyebrow">STEP 05 / HISTORY</text><text class="page-title">历史记录</text><text class="page-intro">两种训练模式独立保存，评分与患者模拟复盘不会混在一起。</text></view>
  <view class="history-mode-switch"><view class="history-mode {{historyMode === 'customer_service' ? 'selected' : ''}}" bindtap="switchHistoryMode" data-mode="customer_service">客服训练</view><view class="history-mode {{historyMode === 'patient_simulation' ? 'selected' : ''}}" bindtap="switchHistoryMode" data-mode="patient_simulation">患者模拟</view></view>
  <view class="history-filter-card">
    <view class="status-filter-row"><text wx:for="{{statusFilters}}" wx:key="id" class="status-filter {{selectedStatus === item.id ? 'selected' : ''}}" bindtap="selectStatus" data-id="{{item.id}}">{{item.name}}</text></view>
  </view>
  <view class="history-tip"><text>状态说明：</text><text>{{historyMode === 'patient_simulation' ? '进行中可续练，已完成可查看学习复盘，已放弃记录仅用于回看。' : '进行中可续练，已完成可查看报告，已放弃记录仅用于回看。'}}</text></view>
  <view class="empty-history card" wx:if="{{sessions.length === 0}}"><text class="empty-icon">暂无</text><text class="empty-title">还没有{{historyMode === 'patient_simulation' ? '患者模拟' : '客服训练'}}记录</text><text class="empty-text">完成一次{{historyMode === 'patient_simulation' ? '患者模拟' : '训练'}}后，完整对话会自动出现在这里。</text></view>
  <view class="history-list" wx:else>
    <view class="history-card card" wx:for="{{sessions}}" wx:key="id">
      <view class="history-card-top"><view><text class="history-scene">{{item.scenarioName}}</text><text class="history-mode-label">{{item.isRoleplay ? '患者模拟' : '客服训练'}}</text></view><text class="status {{item.statusClass}}">{{item.statusText}}</text></view>
      <view class="history-meta"><text>{{item.updatedAt}}</text><text>{{item.currentRound}} / {{item.maxRounds}} 轮</text><text wx:if="{{item.evaluation}}">{{item.evaluation.totalScore}} 分</text><text wx:elif="{{item.isRoleplay}}">{{item.summaryStatus === 'ready' ? '已复盘' : item.summaryStatus === 'failed' ? '复盘待重试' : '复盘生成中'}}</text><text wx:else>未评分</text></view>
      <view class="history-actions"><view class="history-links"><text class="conversation-link" bindtap="toggleConversation" data-id="{{item.id}}">{{expandedId === item.id ? '收起对话' : '查看完整对话'}} ›</text><text wx:if="{{!item.isRoleplay && item.status === 'completed'}}" class="evaluation-link" bindtap="toggleEvaluation" data-id="{{item.id}}">{{expandedEvaluationId === item.id ? '收起摘要' : '查看摘要'}} ›</text></view><button class="history-button {{item.statusClass}}" bindtap="handleAction" data-id="{{item.id}}">{{item.actionText}}</button></view>
      <view class="conversation" wx:if="{{expandedId === item.id}}"><view class="conversation-row {{message.role === 'user' || message.role === 'learner_patient' ? 'mine' : ''}}" wx:for="{{item.messages}}" wx:for-item="message" wx:key="id"><text class="conversation-role">{{message.role === 'user' ? '客服' : message.role === 'patient' ? '患者' : message.role === 'learner_patient' ? '模拟患者（我）' : '标准客服'}}</text><text class="conversation-text">{{message.content}}</text><view class="history-learning" wx:if="{{message.role === 'standard_customer' && message.learningPoints.length}}"><text wx:for="{{message.learningPoints}}" wx:for-item="point" wx:key="*this">• {{point}}</text><text wx:if="{{message.complianceBoundary}}" class="history-boundary">合规边界：{{message.complianceBoundary}}</text></view></view></view>
      <view class="inline-evaluation" wx:if="{{expandedEvaluationId === item.id}}"><text wx:if="{{item.evaluationLoading}}" class="inline-loading">正在读取报告摘要…</text><block wx:elif="{{item.evaluationDetail && !item.evaluationDetail.pending}}"><radar-chart dimensions="{{item.evaluationDetail.dimensions}}" canvas-width="260" canvas-height="230"></radar-chart><text class="inline-summary">{{item.evaluationDetail.summary}}</text><view class="inline-feedback"><view><text class="inline-label positive">做得好</text><text wx:for="{{item.evaluationDetail.strengths}}" wx:for-item="strength" wx:key="round">• {{strength.content}}</text></view><view><text class="inline-label improve">下一步</text><text wx:for="{{item.evaluationDetail.improvements}}" wx:for-item="improvement" wx:key="round">• {{improvement.content}}</text></view></view></block><text wx:else class="inline-loading">报告{{item.evaluationDetail.status === 'failed' ? '生成失败，可从结果页重新评分' : '仍在生成中，请稍后再试'}}</text></view>
    </view>
  </view>
  <text class="disclaimer">完整对话仅保存在当前演示环境，不包含真实患者信息。</text>
  </block>
</view>
