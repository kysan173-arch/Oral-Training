<view class="page-shell history-page">
  <view class="admin-blocked-card" wx:if="{{roleBlocked}}">
    <text class="admin-blocked-icon">主管</text>
    <text class="admin-blocked-title">训练历史为学员功能</text>
    <text class="admin-blocked-desc">主管可通过数据看板查看所有学员的训练记录与详情</text>
    <view class="admin-blocked-btn" bindtap="goAdminDashboard">前往数据看板</view>
  </view>
  <block wx:else>
  <view class="history-header"><text class="page-title">历史记录</text><text class="page-intro">两种训练模式独立保存，评分与患者模拟复盘不会混在一起。</text></view>
  <view class="history-mode-switch"><view class="history-mode {{historyMode === 'customer_service' ? 'selected' : ''}}" bindtap="switchHistoryMode" data-mode="customer_service">客服训练</view><view class="history-mode {{historyMode === 'patient_simulation' ? 'selected' : ''}}" bindtap="switchHistoryMode" data-mode="patient_simulation">患者模拟</view></view>
  <view class="history-filter-card">
    <view class="status-filter-row"><text wx:for="{{statusFilters}}" wx:key="id" class="status-filter {{selectedStatus === item.id ? 'selected' : ''}}" bindtap="selectStatus" data-id="{{item.id}}">{{item.name}}</text></view>
  </view>
  <view class="history-tip"><text>状态说明：</text><text>{{historyMode === 'patient_simulation' ? '进行中可续练，已完成可查看学习复盘，已放弃记录仅用于回看。' : '进行中可续练，已完成可查看报告，已放弃记录仅用于回看。'}}</text></view>

  <!-- 加载骨架 -->
  <view class="history-skeleton" wx:if="{{loading}}">
    <view class="sk-row"></view>
    <view class="sk-row"></view>
    <view class="sk-row"></view>
    <view class="sk-row"></view>
  </view>

  <view class="empty-history" wx:elif="{{sessions.length === 0}}"><empty-state title="还没有{{historyMode === 'patient_simulation' ? '患者模拟' : '客服训练'}}记录" text="完成一次{{historyMode === 'patient_simulation' ? '患者模拟' : '训练'}}后，完整对话会自动出现在这里。"></empty-state></view>
  <view class="history-list" wx:else>
    <view class="history-card card" wx:for="{{sessions}}" wx:key="id" bindtap="openDetail" data-id="{{item.id}}" hover-class="history-card-hover">
      <view class="history-card-top"><view><text class="history-scene">{{item.scenarioName}}</text></view><text class="status {{item.statusClass}}">{{item.statusText}}</text></view>
      <view class="history-meta">
        <text>{{item.updatedAt}}</text>
        <text>{{item.currentRound}} / {{item.maxRounds}} 轮</text>
        <text wx:if="{{item.evaluation}}">{{item.evaluation.totalScore}} 分</text>
        <text wx:elif="{{item.isRoleplay}}">{{item.summaryStatus === 'ready' ? '已复盘' : item.summaryStatus === 'failed' ? '复盘待重试' : '复盘生成中'}}</text>
        <text wx:else>未评分</text>
        <text class="history-arrow">›</text>
      </view>
    </view>
  </view>
  <text class="disclaimer">完整对话仅保存在当前演示环境，不包含真实患者信息。</text>
  </block>
</view>
