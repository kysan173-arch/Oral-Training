.history-page { padding: 34rpx 24rpx 48rpx; background: var(--bg-grad, #FBFAF8); min-height: 100vh; box-sizing: border-box; }
.history-header { padding: 8rpx 8rpx 26rpx; }
.history-mode-switch { display: flex; padding: 6rpx; margin: -4rpx 0 22rpx; border-radius: 20rpx; background: #EEF0FF; }
.history-mode { flex: 1; padding: 16rpx 12rpx; border-radius: 16rpx; color: #8A93AD; font-size: 26rpx; text-align: center; }
.history-mode.selected { color: #fff; background: #5B6EF5; font-weight: 600; }
.history-filter-card { padding: 16rpx 18rpx; margin: -4rpx 0 20rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04); }
.status-filter-row { display: flex; gap: 10rpx; }
.status-filter { flex: 1; padding: 10rpx 6rpx; border-radius: 14rpx; color: #8A93AD; background: #FBFAF8; font-size: 22rpx; text-align: center; }
.status-filter.selected { color: #5B6EF5; background: #EEF0FF; font-weight: 600; }

.eyebrow { display: block; color: #8A93AD; font-size: 22rpx; letter-spacing: 2rpx; }
.page-title { display: block; margin-top: 14rpx; font-size: 32rpx; font-weight: 600; color: #1A1A2E; }
.page-intro { display: block; margin-top: 14rpx; color: #8A93AD; font-size: 26rpx; }
.history-tip { padding: 18rpx 22rpx; margin-bottom: 22rpx; border-radius: 16rpx; color: #3C3A44; background: #fff; font-size: 22rpx; line-height: 1.5; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04); }
.history-tip text:first-child { color: #5B6EF5; font-weight: 600; }
.history-card { padding: 26rpx; margin-bottom: 18rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); }
.history-card-top { display: flex; justify-content: space-between; align-items: center; }
.history-scene { font-size: 26rpx; font-weight: 600; color: #1A1A2E; }
.history-mode-label { display: block; margin-top: 5rpx; color: #8A93AD; font-size: 22rpx; }
.status { padding: 6rpx 16rpx; border-radius: 18rpx; font-size: 22rpx; font-weight: 600; }
.status.in_progress { color: #fff; background: #FF9500; }
.status.completed { color: #fff; background: #5B6EF5; }
.status.abandoned { color: #fff; background: #8A93AD; }
.history-meta { display: flex; justify-content: space-between; margin-top: 14rpx; color: #8A93AD; font-size: 22rpx; }
.history-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.history-links { display: flex; flex-direction: column; gap: 8rpx; }
.conversation-link { color: #5B6EF5; font-size: 22rpx; font-weight: 400; }
.evaluation-link { color: #8A93AD; font-size: 22rpx; }
.history-button { width: 190rpx; height: 62rpx; line-height: 62rpx; margin: 0; padding: 0; border-radius: 32rpx; font-size: 22rpx; font-weight: 400; }
.history-button.in_progress { color: #fff; background: #5B6EF5; }
.history-button.completed { color: #5B6EF5; background: #EEF0FF; }
.history-button.abandoned { color: #8A93AD; background: #EEF0FF; }
.conversation { padding: 18rpx 0 2rpx; margin-top: 20rpx; border-top: 1rpx solid #ECE9E4; }
.conversation-row { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 14rpx; }
.conversation-row.mine { align-items: flex-end; }
.conversation-role { color: #8A93AD; font-size: 22rpx; }
.conversation-text { max-width: 88%; padding: 13rpx 16rpx; margin-top: 5rpx; border-radius: 6rpx 20rpx 20rpx 20rpx; color: #1A1A2E; background: #FBFAF8; font-size: 22rpx; line-height: 1.5; box-shadow: 0 1rpx 4rpx rgba(0,0,0,.03); }
.conversation-row.mine .conversation-text { color: #fff; background: #5B6EF5; border-radius: 20rpx 6rpx 20rpx 20rpx; }
.history-learning { max-width: 88%; padding: 10rpx 14rpx; margin-top: 6rpx; border-radius: 10rpx; color: #5B6EF5; background: #EEF0FF; font-size: 22rpx; line-height: 1.45; }
.history-learning text { display: block; }
.history-boundary { padding-top: 7rpx; margin-top: 7rpx; border-top: 1rpx solid #E0F0E7; color: #FF9500; }
.inline-evaluation { padding: 18rpx 0 2rpx; margin-top: 18rpx; border-top: 1rpx solid #ECE9E4; }
.inline-loading { display: block; padding: 14rpx 0; color: #8A93AD; font-size: 22rpx; text-align: center; }
.inline-summary { display: block; padding: 0 10rpx; color: #3C3A44; font-size: 22rpx; line-height: 1.6; }
.inline-feedback { display: flex; gap: 14rpx; margin-top: 16rpx; }
.inline-feedback view { flex: 1; padding: 14rpx; border-radius: 12rpx; background: #FBFAF8; }
.inline-feedback text { display: block; margin-top: 6rpx; color: #3C3A44; font-size: 22rpx; line-height: 1.45; }
.inline-feedback .inline-label { margin-top: 0; font-size: 22rpx; font-weight: 600; }
.empty-history { background: #fff; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); overflow: hidden; }
.disclaimer { display: block; color: #8A93AD; font-size: 22rpx; text-align: center; }

/* ── 主管拦截卡 ── */
.admin-blocked-card { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 60rpx; text-align: center; }
.admin-blocked-icon { display: inline-block; padding: 16rpx 32rpx; margin-bottom: 30rpx; border-radius: 16rpx; background: #EEF0FF; color: #5B6EF5; font-size: 26rpx; font-weight: 600; }
.admin-blocked-title { display: block; color: #1A1A2E; font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.admin-blocked-desc { display: block; color: #8A93AD; font-size: 26rpx; line-height: 1.6; max-width: 500rpx; margin-bottom: 36rpx; }
.admin-blocked-btn { padding: 18rpx 56rpx; border-radius: 32rpx; color: #fff; background: #5B6EF5; font-size: 26rpx; font-weight: 600; }

/* ── 历史记录加载骨架 ── */
.history-skeleton { margin-bottom: 18rpx; }
.sk-row { height: 130rpx; margin-bottom: 18rpx; border-radius: 20rpx; background: linear-gradient(90deg, #EEF0FF 25%, #E3E8FF 50%, #EEF0FF 75%); background-size: 200% 100%; animation: skeleton-shimmer 1.6s infinite; }
@keyframes skeleton-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
