.history-page { padding: 34rpx 24rpx 48rpx; background: var(--bg-grad, #F7F8FA); min-height: 100vh; box-sizing: border-box; }
.history-header { padding: 8rpx 8rpx 26rpx; }
.history-mode-switch { display: flex; padding: 6rpx; margin: -4rpx 0 22rpx; border-radius: 20rpx; background: #E8E9F0; }
.history-mode { flex: 1; padding: 16rpx 12rpx; border-radius: 16rpx; color: #A1A1AA; font-size: 25rpx; text-align: center; }
.history-mode.selected { color: #fff; background: #5B6EF5; font-weight: 600; }
.history-filter-card { padding: 16rpx 18rpx; margin: -4rpx 0 20rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04); }
.status-filter-row { display: flex; gap: 10rpx; }
.status-filter { flex: 1; padding: 10rpx 6rpx; border-radius: 14rpx; color: #A1A1AA; background: #F7F8FA; font-size: 20rpx; text-align: center; }
.status-filter.selected { color: #5B6EF5; background: #F2F2F7; font-weight: 700; }

.eyebrow { display: block; color: #A1A1AA; font-size: 20rpx; letter-spacing: 2rpx; }
.page-title { display: block; margin-top: 14rpx; font-size: 40rpx; font-weight: 700; color: #1A1A2E; }
.page-intro { display: block; margin-top: 14rpx; color: #A1A1AA; font-size: 25rpx; }
.history-tip { padding: 18rpx 22rpx; margin-bottom: 22rpx; border-radius: 16rpx; color: #6B6B7B; background: #fff; font-size: 22rpx; line-height: 1.5; box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04); }
.history-tip text:first-child { color: #5B6EF5; font-weight: 600; }
.history-card { padding: 26rpx; margin-bottom: 18rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); }
.history-card-top { display: flex; justify-content: space-between; align-items: center; }
.history-scene { font-size: 29rpx; font-weight: 700; color: #1A1A2E; }
.history-mode-label { display: block; margin-top: 5rpx; color: #A1A1AA; font-size: 19rpx; }
.status { padding: 6rpx 16rpx; border-radius: 18rpx; font-size: 21rpx; font-weight: 600; }
.status.in_progress { color: #fff; background: #FF9500; }
.status.completed { color: #fff; background: #34C759; }
.status.abandoned { color: #fff; background: #A1A1AA; }
.history-meta { display: flex; justify-content: space-between; margin-top: 14rpx; color: #A1A1AA; font-size: 22rpx; }
.history-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.history-links { display: flex; flex-direction: column; gap: 8rpx; }
.conversation-link { color: #5B6EF5; font-size: 22rpx; font-weight: 500; }
.evaluation-link { color: #8A93AD; font-size: 21rpx; }
.history-button { width: 190rpx; height: 62rpx; line-height: 62rpx; margin: 0; padding: 0; border-radius: 32rpx; font-size: 23rpx; font-weight: 500; }
.history-button.in_progress { color: #fff; background: #5B6EF5; }
.history-button.completed { color: #5B6EF5; background: #F2F2F7; }
.history-button.abandoned { color: #A1A1AA; background: #F2F2F7; }
.conversation { padding: 18rpx 0 2rpx; margin-top: 20rpx; border-top: 1rpx solid #F0F0F2; }
.conversation-row { display: flex; flex-direction: column; align-items: flex-start; margin-bottom: 14rpx; }
.conversation-row.mine { align-items: flex-end; }
.conversation-role { color: #A1A1AA; font-size: 19rpx; }
.conversation-text { max-width: 88%; padding: 13rpx 16rpx; margin-top: 5rpx; border-radius: 12rpx; color: #1A1A2E; background: #F7F8FA; font-size: 23rpx; line-height: 1.5; }
.conversation-row.mine .conversation-text { color: #fff; background: #5B6EF5; }
.history-learning { max-width: 88%; padding: 10rpx 14rpx; margin-top: 6rpx; border-radius: 10rpx; color: #34C759; background: #F1F9F4; font-size: 20rpx; line-height: 1.45; }
.history-learning text { display: block; }
.history-boundary { padding-top: 7rpx; margin-top: 7rpx; border-top: 1rpx solid #E0F0E7; color: #FF9500; }
.inline-evaluation { padding: 18rpx 0 2rpx; margin-top: 18rpx; border-top: 1rpx solid #F0F0F2; }
.inline-loading { display: block; padding: 14rpx 0; color: #A1A1AA; font-size: 22rpx; text-align: center; }
.inline-summary { display: block; padding: 0 10rpx; color: #6B6B7B; font-size: 23rpx; line-height: 1.6; }
.inline-feedback { display: flex; gap: 14rpx; margin-top: 16rpx; }
.inline-feedback view { flex: 1; padding: 14rpx; border-radius: 12rpx; background: #F7F8FA; }
.inline-feedback text { display: block; margin-top: 6rpx; color: #6B6B7B; font-size: 20rpx; line-height: 1.45; }
.inline-feedback .inline-label { margin-top: 0; font-size: 21rpx; font-weight: 700; }
.empty-history { display: flex; flex-direction: column; align-items: center; padding: 70rpx 30rpx; text-align: center; background: #fff; border-radius: 20rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); }
.empty-icon { display: block; color: #D1D1D6; font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.empty-title { margin-top: 20rpx; font-size: 30rpx; font-weight: 700; color: #1A1A2E; }
.empty-text { margin-top: 12rpx; color: #A1A1AA; font-size: 23rpx; line-height: 1.6; }
.disclaimer { display: block; color: #A1A1AA; font-size: 21rpx; text-align: center; }

/* ── 主管拦截卡 ── */
.admin-blocked-card { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 60rpx; text-align: center; }
.admin-blocked-icon { display: inline-block; padding: 16rpx 32rpx; margin-bottom: 30rpx; border-radius: 16rpx; background: #F2F2F7; color: #5B6EF5; font-size: 28rpx; font-weight: 700; }
.admin-blocked-title { display: block; color: #1A1A2E; font-size: 34rpx; font-weight: 700; margin-bottom: 16rpx; }
.admin-blocked-desc { display: block; color: #A1A1AA; font-size: 24rpx; line-height: 1.6; max-width: 500rpx; margin-bottom: 36rpx; }
.admin-blocked-btn { padding: 18rpx 56rpx; border-radius: 32rpx; color: #fff; background: #5B6EF5; font-size: 25rpx; font-weight: 600; }
