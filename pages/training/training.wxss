.training-page {
  display: flex;
  height: 100vh;
  flex-direction: column;
  overflow: hidden;
  background: #f5f7fb;
}

.session-header {
  display: flex;
  flex-shrink: 0;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: #1677e8;
}

.session-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding-right: 20rpx;
}

.scenario-name {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.patient-profile,
.round-text {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 23rpx;
  line-height: 1.5;
}

.finish-button {
  height: 60rpx;
  margin: 0;
  padding: 0 20rpx;
  color: #1677e8;
  background: #fff;
  border-radius: 30rpx;
  font-size: 23rpx;
  line-height: 60rpx;
}

.finish-button::after {
  border: none;
}

.chat-area {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.chat-inner {
  padding: 24rpx;
}

.message-item,
.typing-state {
  display: flex;
  align-items: flex-start;
  margin-bottom: 26rpx;
}

.user-message {
  flex-direction: row-reverse;
}

.message-avatar {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #1677e8;
  background: #dcecff;
  border-radius: 50%;
  font-size: 24rpx;
}

.user-message .message-avatar {
  color: #fff;
  background: #1677e8;
}

.message-body {
  max-width: 75%;
  margin: 0 16rpx;
}

.user-message .message-body {
  text-align: right;
}

.message-bubble {
  padding: 18rpx 22rpx;
  color: #26364a;
  background: #fff;
  border-radius: 18rpx;
  text-align: left;
}

.user-message .message-bubble {
  color: #fff;
  background: #1677e8;
}

.message-content {
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.message-meta {
  margin-top: 8rpx;
  text-align: left;
}

.emotion-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 21rpx;
}

.emotion-doubt {
  color: #ad6b00;
  background: #fff4d6;
}

.emotion-accept {
  color: #188451;
  background: #e8f8ef;
}

.emotion-price {
  color: #1677e8;
  background: #eaf3ff;
}

.emotion-anxiety {
  color: #d94f58;
  background: #fff0f0;
}

.emotion-angry {
  color: #c41d1d;
  background: #fff1f1;
}

.emotion-cooperate {
  color: #1677e8;
  background: #eaf3ff;
}

.emotion-hesitate {
  color: #8a5cf5;
  background: #f0ecff;
}

.message-time {
  display: block;
  margin-top: 8rpx;
  color: #9aa7b7;
  font-size: 20rpx;
}

/* System hint message */
.message-item .message-bubble .message-content {
  color: #6b7280;
  font-style: italic;
}

/* Golden phrase bar */
.golden-phrase-bar {
  margin-bottom: 26rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fef9e7, #fdf2d6);
  border-radius: 18rpx;
  border: 1rpx solid #f5e6a8;
}

.golden-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.golden-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.golden-title {
  flex: 1;
  color: #ad6b00;
  font-size: 25rpx;
  font-weight: 700;
}

.golden-close {
  color: #9aa7b7;
  font-size: 26rpx;
  padding: 8rpx;
}

.golden-content {
  color: #5c4a1e;
  font-size: 26rpx;
  line-height: 1.7;
}

.typing-state {
  align-items: center;
  color: #8a97a8;
  font-size: 24rpx;
}

.typing-state .message-avatar {
  margin-right: 16rpx;
}

.input-area {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  gap: 12rpx;
  background: #fff;
  border-top: 1rpx solid #e8edf3;
}

.input-field {
  width: 100%;
  height: 80rpx;
  padding: 0 22rpx;
  color: #26364a;
  background: #f3f6fa;
  border-radius: 18rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.button-row {
  display: flex;
  gap: 12rpx;
}

.hint-button {
  flex: 1;
  height: 72rpx;
  margin: 0;
  padding: 0;
  color: #1677e8;
  background: #eaf3ff;
  border-radius: 36rpx;
  font-size: 24rpx;
  line-height: 72rpx;
}

.hint-button::after {
  border: none;
}

.hint-button[disabled] {
  opacity: 0.45;
}

.send-button {
  flex: 1;
  height: 72rpx;
  margin: 0;
  padding: 0;
  color: #fff;
  background: #1677e8;
  border-radius: 36rpx;
  font-size: 27rpx;
  line-height: 72rpx;
}

.send-button::after {
  border: none;
}

.send-button[disabled],
.finish-button[disabled] {
  opacity: 0.55;
}

.error-panel {
  margin: 24rpx;
  padding: 24rpx;
  color: #c84b4b;
  background: #fff1f1;
  border-radius: 18rpx;
  font-size: 26rpx;
}

.end-loading {
  flex-shrink: 0;
  padding: 30rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  color: #66778c;
  background: #fff;
  text-align: center;
  font-size: 26rpx;
}
