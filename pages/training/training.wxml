<view class="training-page">
  <view class="session-header">
    <view class="session-copy">
      <text class="scenario-name">{{scenarioName}}</text>
      <text class="patient-profile">{{patientProfile || 'AI 模拟患者正在准备中'}}</text>
      <text class="round-text">第 {{currentRound}} / {{maxRounds}} 轮 · 剩余 {{remainingRounds}} 轮</text>
    </view>
    <button
      wx:if="{{!isTrainingEnd}}"
      class="finish-button"
      data-reason="manual"
      bindtap="finishTraining"
      disabled="{{sending || finishing}}"
    >结束训练</button>
  </view>

  <view wx:if="{{errorMessage}}" class="error-panel">
    <text>{{errorMessage}}</text>
  </view>

  <scroll-view
    wx:if="{{!errorMessage}}"
    class="chat-area"
    scroll-y
    scroll-into-view="{{scrollToView}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="chat-inner">
      <chat-message wx:for="{{messages}}" wx:key="id" message="{{item}}"></chat-message>

      <!-- Golden phrase recommendation -->
      <view wx:if="{{goldenPhrase}}" class="golden-phrase-bar">
        <view class="golden-header">
          <text class="golden-icon">💡</text>
          <text class="golden-title">黄金话术推荐</text>
          <text class="golden-close" bindtap="dismissGoldenPhrase">✕</text>
        </view>
        <text class="golden-content">{{goldenPhrase}}</text>
      </view>

      <view wx:if="{{sending}}" class="typing-state">
        <text class="message-avatar">患</text>
        <text>患者正在输入…</text>
      </view>
      <view id="msg-bottom"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!isTrainingEnd && !errorMessage}}" class="input-area">
    <input
      class="input-field"
      placeholder="输入你的回复..."
      value="{{inputValue}}"
      bindinput="onInputChange"
      confirm-type="send"
      bindconfirm="sendMessage"
      disabled="{{sending || finishing}}"
    />
    <view class="button-row">
      <button
        class="hint-button"
        bindtap="getHint"
        disabled="{{sending || finishing || currentRound < 1}}"
      >提示</button>
      <button class="send-button" bindtap="sendMessage" disabled="{{sending || finishing}}">发送</button>
    </view>
  </view>

  <view wx:if="{{isTrainingEnd && !isMock}}" class="end-loading">
    <text>训练已结束，正在生成评分报告…</text>
  </view>
</view>
