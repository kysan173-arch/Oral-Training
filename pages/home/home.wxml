<view class="home-page">
  <!-- Search bar -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索话术（如：种植牙、价格、疼痛）"
      value="{{searchValue}}"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
      confirm-type="search"
    />
    <text class="search-clear" wx:if="{{searchValue}}" bindtap="onClearSearch">✕</text>
  </view>

  <!-- Hero banner -->
  <view class="hero-card">
    <text class="hero-title">AI 口腔客服陪练</text>
    <text class="hero-desc">模拟真实患者对话，训练沟通、挖掘需求、提升转化，零压力反复练习。</text>
    <button class="hero-btn" bindtap="goTraining">开始训练</button>
  </view>

  <!-- Hot phrases swiper -->
  <view class="section-header">
    <text class="section-title">热门话术</text>
    <view class="swiper-dots">
      <view class="dot {{index === currentSwiper ? 'active' : ''}}" wx:for="{{phrases}}" wx:key="id"></view>
    </view>
  </view>

  <swiper
    wx:if="{{phrases.length > 0}}"
    class="phrase-swiper"
    current="{{currentSwiper}}"
    bindchange="onSwiperChange"
    indicator-dots="{{false}}"
    autoplay="{{true}}"
    interval="{{4000}}"
    circular="{{true}}"
  >
    <swiper-item wx:for="{{phrases}}" wx:key="id">
      <view class="phrase-card">
        <view class="phrase-tag tag-{{item.tagClass}}">{{item.scenario}}</view>
        <text class="phrase-title">{{item.title}}</text>
      </view>
    </swiper-item>
  </swiper>

  <view wx:if="{{phrases.length === 0}}" class="empty-state">没有找到匹配的话术</view>

  <!-- Quick entry cards -->
  <view class="entry-list">
    <view class="entry-card" bindtap="goPhraseVault">
      <view class="entry-icon icon-gold">★</view>
      <view class="entry-info">
        <text class="entry-name">话术锦囊</text>
        <text class="entry-desc">浏览高转化话术，支持按场景筛选和收藏</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <!-- Boundary notice -->
  <view class="boundary-card">
    <text class="boundary-title">使用边界</text>
    <text class="boundary-text">AI 仅模拟患者角色进行沟通训练，评分用于学习反馈，不构成医疗建议或正式考核。</text>
  </view>
</view>
