<view class="page-shell home-page">
  <view class="hero-card">
    <view class="hero-decoration decoration-one"></view>
    <view class="hero-decoration decoration-two"></view>
    <text class="eyebrow">AI ORAL CARE TRAINING · MVP DEMO</text>
    <text class="hero-title">口腔客服智能陪练</text>
    <text class="hero-subtitle">客服训练 · 患者模拟 · 结构化复盘</text>
    <text class="hero-description">面向新入口腔客服的低风险练习空间，帮助你在典型场景中练习沟通、服务表达和合规边界。</text>
    <button class="primary-button hero-button" bindtap="startTraining">{{isAdmin ? '查看机构数据' : '开始训练'}}</button>
  </view>

  <view class="model-key-card card" wx:if="{{showKeyConfig}}">
    <text class="model-key-title">DeepSeek 模型密钥</text>
    <view class="key-input-row">
      <input class="key-input" password placeholder="输入 DeepSeek API Key" value="{{apiKey}}" bindinput="onKeyInput" disabled="{{savingKey}}" />
      <button class="key-save-button" bindtap="saveApiKey" disabled="{{savingKey || !apiKey}}">{{savingKey ? '配置中' : '配置'}}</button>
    </view>
    <text class="key-status" wx:if="{{keyStatus}}">{{keyStatus}}</text>
  </view>

  <view class="section-heading stats-heading">
    <view><text class="section-title">训练数据</text><text class="section-caption">{{dataCaption}}</text></view>
    <text class="section-link" bindtap="viewDashboard">查看数据 ›</text>
  </view>
  <view class="stats-grid">
    <view class="stat-card card"><text class="stat-value">{{dashboard.totalCount}}</text><text class="stat-label">总训练次数</text></view>
    <view class="stat-card card"><text class="stat-value">{{dashboard.completedCount}}</text><text class="stat-label">已完成次数</text></view>
    <view class="stat-card card"><text class="stat-value">{{dashboard.averageScore}}</text><text class="stat-label">平均得分</text></view>
  </view>

  <view class="quick-links" wx:if="{{!isAdmin}}">
    <view class="quick-link card" bindtap="startTraining"><text class="quick-icon">✦</text><view><text class="quick-title">开始一次新的练习</text><text class="quick-text">四个固定场景可选</text></view><text class="quick-arrow">›</text></view>
    <view class="quick-link card" bindtap="viewHistory"><text class="quick-icon">↺</text><view><text class="quick-title">回看历史记录</text><text class="quick-text">继续未完成训练或查看报告</text></view><text class="quick-arrow">›</text></view>
    <view class="quick-link card" bindtap="viewProfile"><text class="quick-icon">◔</text><view><text class="quick-title">查看个人成长</text><text class="quick-text">回顾五维能力与练习重点</text></view><text class="quick-arrow">›</text></view>
    <view class="quick-link card" bindtap="viewMine"><text class="quick-icon">★</text><view><text class="quick-title">我的成长与签到</text><text class="quick-text">每日 +10 积分，收藏常用话术</text></view><text class="quick-arrow">›</text></view>
    <view class="quick-link card" bindtap="viewPhrases"><text class="quick-icon">▤</text><view><text class="quick-title">打开话术锦囊</text><text class="quick-text">收录已完成报告中的推荐表达</text></view><text class="quick-arrow">›</text></view>
    <view class="quick-link card" bindtap="viewMistakes"><text class="quick-icon">↻</text><view><text class="quick-title">进行错题复练</text><text class="quick-text">针对真实报告中的改进项练习</text></view><text class="quick-arrow">›</text></view>
  </view>

</view>
