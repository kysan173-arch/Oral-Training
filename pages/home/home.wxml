<view class="page-shell home-v2">
  <!-- 搜索框 -->
  <view class="search-section">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input"
             placeholder="搜索话术（如「种植牙」「价格」）"
             value="{{searchKeyword}}"
             bindinput="onSearchInput"
             bindconfirm="onSearchConfirm"
             confirm-type="search" />
      <text class="search-btn" bindtap="onSearchConfirm" wx:if="{{searchKeyword}}">搜索</text>
    </view>
  </view>

  <!-- 热门话术轮播 — 简洁卡片，点击跳话术锦囊 -->
  <view class="phrase-carousel-section" wx:if="{{phrasePreview.length > 0}}">
    <view class="section-header">
      <text class="section-head">热门话术</text>
      <text class="section-more" bindtap="goPhrases">话术锦囊 ›</text>
    </view>
    <swiper class="phrase-swiper"
            indicator-dots="{{true}}"
            indicator-color="rgba(102,126,234,.25)"
            indicator-active-color="#667eea"
            autoplay="{{true}}"
            interval="{{4000}}"
            circular="{{true}}">
      <swiper-item wx:for="{{phrasePreview}}" wx:key="csReplies">
        <view class="phrase-swiper-card" bindtap="goPhrases">
          <view class="psc-header">
            <text class="psc-scenario-tag">{{item.scenarioName}}</text>
            <text class="psc-tap-hint">点击查看完整对话 ›</text>
          </view>
          <text class="psc-phrase-text">"{{item.csReplies}}"</text>
        </view>
      </swiper-item>
    </swiper>
  </view>
  <view class="empty-hint card" wx:elif="{{overview && phrasePreview.length === 0}}">
    <text>完成训练后，这里会展示热门话术卡片。点击可跳转话术锦囊查看完整对话示范。</text>
  </view>

  <!-- 场景训练入口 -->
  <view class="section-header">
    <text class="section-head">训练场景</text>
    <text class="section-more" bindtap="goTraining">全部场景 ›</text>
  </view>
  <view class="scenario-grid" wx:if="{{scenarioStatus.length > 0}}">
    <view class="scenario-grid-card card" wx:for="{{scenarioStatus}}" wx:key="scenarioId" bindtap="startScenario" data-id="{{item.scenarioId}}">
      <view class="sgc-top">
        <text class="sgc-name">{{item.name}}</text>
        <text class="sgc-diff {{item.difficulty === 'advanced' ? 'diff-adv' : 'diff-basic'}}">{{item.difficultyText}}</text>
      </view>
      <text class="sgc-desc">{{item.summary}}</text>
      <view class="sgc-bottom">
        <text class="sgc-progress {{item.completedCount > 0 ? 'progress-done' : ''}}">{{item.progressText}}</text>
        <text class="sgc-arrow">开始训练 ›</text>
      </view>
    </view>
  </view>

  <!-- 成长档案入口 -->
  <view class="section-header">
    <text class="section-head">成长档案</text>
  </view>
  <view class="growth-entries">
    <view class="growth-entry card" bindtap="goProfile">
      <text class="ge-emoji">📊</text>
      <view class="ge-info"><text class="ge-title">能力画像</text><text class="ge-desc">五维成长曲线 · 短板诊断</text></view>
      <text class="ge-arrow">›</text>
    </view>
    <view class="growth-entry card" bindtap="goMistakes">
      <text class="ge-emoji">📝</text>
      <view class="ge-info"><text class="ge-title">错题本</text><text class="ge-desc">待改进回合 · 复练提升</text></view>
      <text class="ge-arrow">›</text>
    </view>
  </view>

  <text class="disclaimer">AI模拟训练，不构成医疗建议；评分不替代医生、客服专家或正式培训考核。</text>
</view>
