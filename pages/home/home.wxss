.home-v2 { padding: 0 24rpx 48rpx; }

/* ==================== 搜索框 ==================== */
.search-section { margin-top: 20rpx; }
.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 22rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 2rpx 14rpx rgba(0,0,0,.05);
}
.search-icon { font-size: 28rpx; margin-right: 10rpx; opacity: .5; }
.search-input { flex: 1; height: 56rpx; font-size: 25rpx; color: #333; }
.search-btn { padding: 8rpx 24rpx; border-radius: 30rpx; color: #fff; font-size: 23rpx; background: #667eea; }

/* ==================== 通用 section-header ==================== */
.section-header { display: flex; align-items: center; justify-content: space-between; margin: 36rpx 4rpx 18rpx; }
.section-head { font-size: 32rpx; font-weight: 700; color: #333; }
.section-more { color: #667eea; font-size: 23rpx; }

/* ==================== 热门话术轮播 ==================== */
.phrase-carousel-section { margin-top: 8rpx; }
.phrase-swiper { height: 200rpx; }
.phrase-swiper-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin: 4rpx 6rpx 10rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,.06);
}
.psc-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.psc-scenario-tag {
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
  color: #667eea;
  background: #eef2ff;
  font-size: 20rpx;
  font-weight: 600;
}
.psc-tap-hint { color: #bbb; font-size: 20rpx; }
.psc-phrase-text {
  display: block;
  color: #445;
  font-size: 26rpx;
  line-height: 1.55;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ==================== 空态 ==================== */
.empty-hint { padding: 28rpx; color: #999; font-size: 23rpx; line-height: 1.6; text-align: center; }

/* ==================== 场景网格 ==================== */
.scenario-grid { display: flex; flex-direction: column; gap: 16rpx; }
.scenario-grid-card { padding: 26rpx; }
.sgc-top { display: flex; align-items: center; justify-content: space-between; }
.sgc-name { font-size: 28rpx; font-weight: 700; color: #333; }
.sgc-diff { padding: 4rpx 14rpx; border-radius: 16rpx; font-size: 20rpx; }
.diff-basic { color: #5672bd; background: #eef2ff; }
.diff-adv { color: #bd7a35; background: #fff2df; }
.sgc-desc { display: block; margin-top: 12rpx; color: #888; font-size: 23rpx; line-height: 1.5; }
.sgc-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx solid #f2f2f6; }
.sgc-progress { color: #bbb; font-size: 21rpx; }
.sgc-progress.progress-done { color: #52a67a; }
.sgc-arrow { color: #667eea; font-size: 23rpx; font-weight: 600; }

.disclaimer { display: block; margin-top: 30rpx; color: #aaa; font-size: 21rpx; line-height: 1.5; text-align: center; }

/* 成长档案入口 */
.growth-entries { display: flex; flex-direction: column; gap: 14rpx; }
.growth-entry { display: flex; align-items: center; padding: 24rpx 22rpx; }
.ge-emoji { font-size: 40rpx; margin-right: 18rpx; }
.ge-info { flex: 1; display: flex; flex-direction: column; }
.ge-title { font-size: 26rpx; font-weight: 700; color: #333; }
.ge-desc { margin-top: 4rpx; font-size: 21rpx; color: #aaa; }
.ge-arrow { color: #ccc; font-size: 32rpx; }

/* ==================== 全局卡片基线 ==================== */
.card { border-radius: 20rpx; background: #fff; box-shadow: 0 3rpx 14rpx rgba(0,0,0,.04); }
