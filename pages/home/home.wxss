.home-page { padding: 28rpx 24rpx 48rpx; }
.hero-card { position: relative; overflow: hidden; padding: 46rpx 36rpx 38rpx; border-radius: 28rpx; color: #fff; background: linear-gradient(135deg, #667eea, #764ba2); box-shadow: 0 14rpx 34rpx rgba(102, 126, 234, .25); }
.hero-decoration { position: absolute; border-radius: 50%; background: rgba(255,255,255,.10); }
.decoration-one { width: 260rpx; height: 260rpx; right: -90rpx; top: -100rpx; }
.decoration-two { width: 140rpx; height: 140rpx; right: 90rpx; bottom: -90rpx; }
.eyebrow, .hero-title, .hero-subtitle, .hero-description { position: relative; display: block; }
.eyebrow { font-size: 20rpx; letter-spacing: 2rpx; }
.hero-title { margin-top: 22rpx; font-size: 48rpx; font-weight: 700; letter-spacing: 3rpx; }
.hero-subtitle { margin-top: 14rpx; font-size: 27rpx; opacity: .95; }
.hero-description { width: 92%; margin-top: 20rpx; font-size: 24rpx; line-height: 1.65; opacity: .78; }
.hero-button { position: relative; width: 100%; height: 84rpx; margin-top: 34rpx; line-height: 1.2; color: #5e68c9; background: #fff; box-shadow: 0 8rpx 20rpx rgba(39,44,100,.15); }
.model-key-card { margin: 22rpx 0 34rpx; padding: 24rpx; }
.model-key-title, .model-key-text, .key-status { display: block; }
.model-key-title { color: #333; font-size: 28rpx; font-weight: 600; }
.model-key-text { margin-top: 8rpx; color: #999; font-size: 22rpx; line-height: 1.5; }
.key-input-row { display: flex; gap: 14rpx; align-items: center; margin-top: 18rpx; }
.key-input { flex: 1; height: 66rpx; padding: 0 16rpx; border: 1rpx solid #e2e3ef; border-radius: 12rpx; color: #333; font-size: 24rpx; }
.key-save-button { flex: 0 0 120rpx; height: 66rpx; margin: 0; padding: 0; border-radius: 12rpx; line-height: 66rpx; color: #fff; background: #667eea; font-size: 24rpx; }
.key-status { margin-top: 10rpx; color: #52a67a; font-size: 22rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 4rpx 18rpx; }
.section-title, .section-caption { display: block; }
.section-title { font-size: 32rpx; font-weight: 700; }
.section-caption { margin-top: 6rpx; color: #aaa; font-size: 22rpx; }
.mvp-badge { padding: 7rpx 16rpx; border-radius: 20rpx; color: #667eea; background: #eef0ff; font-size: 20rpx; font-weight: 700; }
.flow-card { display: flex; align-items: center; justify-content: space-around; padding: 26rpx 18rpx; }
.flow-item { display: flex; flex-direction: column; align-items: center; color: #555; font-size: 23rpx; }
.flow-number { margin-bottom: 10rpx; color: #667eea; font-size: 22rpx; font-weight: 700; }
.flow-arrow { color: #c9c9d9; font-size: 42rpx; font-weight: 200; }
.stats-heading { margin-top: 36rpx; }
.section-link { color: #667eea; font-size: 23rpx; }
.stats-grid { display: flex; gap: 16rpx; }
.stat-card { flex: 1; padding: 24rpx 8rpx; text-align: center; }
.stat-value, .stat-label { display: block; }
.stat-value { color: #667eea; font-size: 42rpx; font-weight: 700; }
.stat-label { margin-top: 8rpx; color: #999; font-size: 21rpx; }
.quick-links { margin-top: 22rpx; }
.quick-link { display: flex; align-items: center; padding: 24rpx; margin-bottom: 16rpx; }
.quick-icon { width: 58rpx; height: 58rpx; line-height: 58rpx; border-radius: 18rpx; text-align: center; color: #667eea; background: #f0f1ff; font-size: 34rpx; }
.quick-link view { flex: 1; margin-left: 18rpx; }
.quick-title, .quick-text { display: block; }
.quick-title { font-size: 27rpx; font-weight: 600; }
.quick-text { margin-top: 7rpx; color: #aaa; font-size: 22rpx; }
.quick-arrow { color: #bbb; font-size: 38rpx; }
.disclaimer { display: block; padding: 18rpx 12rpx 0; color: #aaa; font-size: 21rpx; line-height: 1.5; text-align: center; }
