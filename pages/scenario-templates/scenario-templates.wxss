.tpl-page { padding: 24rpx 28rpx 60rpx; }

/* ── 页头 ── */
.tpl-hero { padding: 26rpx 28rpx; margin-bottom: 24rpx; }
.tpl-hero-title { display: block; font-size: 32rpx; font-weight: 600; color: var(--text-strong); }
.tpl-hero-desc { display: block; margin-top: 12rpx; font-size: 23rpx; line-height: 1.7; color: var(--text-secondary); }

/* ── 加载 / 失败 ── */
.loading-card { text-align: center; color: var(--text-secondary); font-size: 26rpx; }
.tpl-failed { padding: 40rpx 30rpx; text-align: center; }
.tpl-failed-title { display: block; font-size: 30rpx; font-weight: 600; color: var(--text-strong); }
.tpl-failed-text { display: block; margin-top: 10rpx; font-size: 23rpx; color: var(--text-secondary); }
.tpl-failed-action { display: inline-block; margin-top: 22rpx; padding: 16rpx 48rpx; }

/* ── 分类分组 ── */
.tpl-group { margin-bottom: 32rpx; }
.tpl-group-head {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 0 4rpx;
}
.tpl-group-name { font-size: 29rpx; font-weight: 600; color: var(--text-strong); }
.tpl-group-count { flex-shrink: 0; font-size: 22rpx; color: var(--text-muted); }
.tpl-group-desc { display: block; padding: 0 4rpx; margin-top: 6rpx; margin-bottom: 16rpx; font-size: 22rpx; line-height: 1.6; color: var(--text-muted); }

/* ── 模板卡 ── */
.tpl-card { padding: 24rpx 26rpx; margin-bottom: 16rpx; }
.tpl-card-hover { opacity: 0.85; }
.tpl-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.tpl-card-name { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; color: var(--text-strong); }
.tpl-card-use { flex-shrink: 0; font-size: 24rpx; color: var(--color-primary); }
.tpl-card-summary { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.6; color: var(--text-secondary); }
.tpl-card-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }

.tpl-foot { display: block; padding: 0 8rpx; font-size: 22rpx; line-height: 1.7; color: var(--text-muted); text-align: center; }
