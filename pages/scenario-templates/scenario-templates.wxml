<view class="page-shell tpl-page">
  <view class="tpl-hero card">
    <text class="tpl-hero-title">按骨架模板新建</text>
  </view>

  <view class="loading-card card" wx:if="{{loading}}"><text>正在加载模板…</text></view>

  <view class="tpl-failed card" wx:elif="{{failed}}">
    <text class="tpl-failed-title">模板加载失败</text>
    <text class="tpl-failed-text">可能是网络波动，你的场景数据不受影响。</text>
    <view class="tpl-failed-action btn btn-secondary" bindtap="retry">重新加载</view>
  </view>

  <block wx:else>
    <view class="tpl-group" wx:for="{{groups}}" wx:key="id">
      <view class="tpl-group-head">
        <text class="tpl-group-name">{{item.name}}</text>
        <text class="tpl-group-count">{{item.items.length}} 个骨架</text>
      </view>

      <view
        class="tpl-card card"
        wx:for="{{item.items}}"
        wx:for-item="tpl"
        wx:key="id"
        data-id="{{tpl.id}}"
        bindtap="pick"
        hover-class="tpl-card-hover"
      >
        <view class="tpl-card-head">
          <text class="tpl-card-name">{{tpl.name}}</text>
          <text class="tpl-card-use">使用 ›</text>
        </view>
        <text class="tpl-card-summary">{{tpl.summary}}</text>
        <view class="tpl-card-meta">
          <text class="tag tag-neutral">{{tpl.difficultyText}}</text>
          <text class="tag tag-primary" wx:if="{{tpl.focusText}}">{{tpl.focusText}}</text>
        </view>
      </view>
    </view>

    <empty-state
      wx:if="{{groups.length === 0}}"
      title="暂无骨架模板"
      text="模板由迁移 025 提供。这里为空说明该环境还没有执行那条迁移。"
      actionText="返回场景管理"
      bind:action="goBack"
    ></empty-state>
  </block>
</view>
