.editor-page { min-height: 100vh; padding: 26rpx 22rpx 70rpx; box-sizing: border-box; background: #f5f6fa; }
.editor-hero { padding: 28rpx; border-radius: 22rpx; color: #fff; background: linear-gradient(135deg,#5967c8,#7657a8); }
.editor-hero text { display: block; }
.editor-hero text:first-child { font-size: 34rpx; font-weight: 700; }
.editor-hero text:last-child { margin-top: 8rpx; color: rgba(255,255,255,.75); font-size: 21rpx; }
.card { margin: 16rpx 0; }
.loading { color: #969cad; text-align: center; }
.section-title { color: #434c63; font-size: 28rpx; font-weight: 700; }
.section-head,.switch-row { display: flex; align-items: center; justify-content: space-between; }
.label { display: block; margin: 22rpx 0 8rpx; color: #7e8598; font-size: 21rpx; }
input,.picker-value,textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #e4e6ef; border-radius: 13rpx; color: #424a60; background: #fafbfe; font-size: 24rpx; }
input,.picker-value { min-height: 68rpx; padding: 14rpx 18rpx; }
textarea { min-height: 120rpx; padding: 16rpx 18rpx; }
.two-column { display: flex; gap: 16rpx; }
.two-column > view { flex: 1; }
.state-button { width: 170rpx; height: 54rpx; line-height: 54rpx; color: #5967bd; background: #edf0ff; font-size: 20rpx; }
.switch-row { margin-top: 18rpx; color: #6e768a; font-size: 22rpx; }
.warning,.job-state { display: block; margin: 13rpx 0; color: #9a794b; font-size: 21rpx; line-height: 1.55; }
.job-state { color: #6d7690; }
.revision { padding: 16rpx 0; border-bottom: 1rpx solid #eef0f5; }
.revision text { display: block; color: #596176; font-size: 21rpx; }
.revision text + text { margin-top: 5rpx; color: #979dac; }
.hash { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.actions { margin-top: 24rpx; }
.action { width: 100%; height: 76rpx; margin-top: 14rpx; border: 0; font-size: 25rpx; }
.publish-button { color: #fff; background: #4c9a68; border-radius: 40rpx; }
.archive-button { color: #a25d5d; background: #faeeee; border-radius: 40rpx; }
