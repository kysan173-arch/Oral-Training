<view class="editor-page">
  <view class="editor-hero"><text>{{serviceId ? '编辑服务草稿' : '新建服务草稿'}}</text><text>草稿 v{{draftVersion || '-'}} · {{status === 'archived' ? '已归档' : '可编辑'}} · synthetic</text></view>
  <view class="loading card" wx:if="{{loading}}">正在加载…</view>
  <block wx:else>
    <view class="section card"><text class="section-title">基本信息</text><text class="label">服务名称</text><input value="{{form.name}}" data-path="name" bindinput="onInput" placeholder="例如：演示种植服务 A"/><text class="label">分类</text><input value="{{form.category}}" data-path="category" bindinput="onInput" placeholder="例如：implant"/><text class="label">内部备注（不进入公开投影）</text><textarea value="{{form.adminNotes}}" data-path="adminNotes" bindinput="onInput"/></view>

    <view class="section card"><view class="section-head"><text class="section-title">价格</text><button class="state-button" data-path="price" bindtap="toggleStatus">{{form.price.status === 'known' ? '设为未知' : '录入已知值'}}</button></view><block wx:if="{{form.price.status === 'unknown'}}"><text class="label">未知原因</text><input value="{{form.price.reason}}" data-path="price.reason" bindinput="onInput"/></block><block wx:else><text class="label">价格类型</text><picker range="{{priceTypes}}" data-path="price.type" data-options="priceTypes" bindchange="onSelect"><view class="picker-value">{{form.price.type}}</view></picker><text class="label" wx:if="{{form.price.type === 'fixed' || form.price.type === 'starting_from'}}">金额（分）</text><input wx:if="{{form.price.type === 'fixed' || form.price.type === 'starting_from'}}" type="number" value="{{form.price.amountMinor}}" data-path="price.amountMinor" bindinput="onInput"/><view class="two-column" wx:if="{{form.price.type === 'range'}}"><view><text class="label">最低（分）</text><input type="number" value="{{form.price.minimumMinor}}" data-path="price.minimumMinor" bindinput="onInput"/></view><view><text class="label">最高（分）</text><input type="number" value="{{form.price.maximumMinor}}" data-path="price.maximumMinor" bindinput="onInput"/></view></view><text class="label">单位</text><picker range="{{priceUnits}}" data-path="price.unit" data-options="priceUnits" bindchange="onSelect"><view class="picker-value">{{form.price.unit}}</view></picker><text class="label">适用条件</text><textarea value="{{form.price.conditions}}" data-path="price.conditions" bindinput="onInput"/><view class="two-column"><view><text class="label">生效日期</text><input value="{{form.price.validFrom}}" data-path="price.validFrom" bindinput="onInput" placeholder="YYYY-MM-DD"/></view><view><text class="label">失效日期</text><input value="{{form.price.validUntil}}" data-path="price.validUntil" bindinput="onInput" placeholder="YYYY-MM-DD"/></view></view></block></view>

    <view class="section card" wx:for="{{durationFields}}" wx:key="key"><view class="section-head"><text class="section-title">{{item.name}}</text><button class="state-button" data-path="{{item.key}}" bindtap="toggleStatus">{{form[item.key].status === 'known' ? '设为未知' : '录入已知值'}}</button></view><block wx:if="{{form[item.key].status === 'unknown'}}"><text class="label">未知原因</text><input value="{{form[item.key].reason}}" data-path="{{item.key}}.reason" bindinput="onInput"/></block><block wx:else><view class="two-column"><view><text class="label">最短</text><input type="number" value="{{form[item.key].minimum}}" data-path="{{item.key}}.minimum" bindinput="onInput"/></view><view><text class="label">最长</text><input type="number" value="{{form[item.key].maximum}}" data-path="{{item.key}}.maximum" bindinput="onInput"/></view></view><text class="label">单位</text><picker range="{{durationUnits}}" data-path="{{item.key}}.unit" data-options="durationUnits" bindchange="onSelect"><view class="picker-value">{{form[item.key].unit}}</view></picker><view class="switch-row"><text>是否估算值</text><switch checked="{{form[item.key].estimated}}" data-path="{{item.key}}" bindchange="onEstimatedChange"/></view></block></view>

    <view class="section card"><view class="section-head"><text class="section-title">预约说明</text><button class="state-button" data-path="appointment" bindtap="toggleStatus">{{form.appointment.status === 'known' ? '设为未知' : '录入已知值'}}</button></view><block wx:if="{{form.appointment.status === 'unknown'}}"><text class="label">未知原因</text><input value="{{form.appointment.reason}}" data-path="appointment.reason" bindinput="onInput"/></block><block wx:else><text class="label">类型</text><picker range="{{appointmentTypes}}" data-path="appointment.type" data-options="appointmentTypes" bindchange="onSelect"><view class="picker-value">{{form.appointment.type}}</view></picker><text class="label">时区</text><input value="{{form.appointment.timezone}}" data-path="appointment.timezone" bindinput="onInput"/><text class="label">说明（不能冒充实时号源）</text><textarea value="{{form.appointment.text}}" data-path="appointment.text" bindinput="onInput"/></block></view>

    <view class="section card"><text class="section-title">范围与关联</text><text class="label">包含项目（逗号或换行分隔）</text><textarea value="{{listText.includedItems}}" data-key="includedItems" bindinput="onListInput"/><text class="label">不包含项目</text><textarea value="{{listText.excludedItems}}" data-key="excludedItems" bindinput="onListInput"/><text class="label">专业主题</text><textarea value="{{listText.professionalTopics}}" data-key="professionalTopics" bindinput="onListInput"/><text class="label">场景 ID</text><textarea value="{{listText.scenarioIds}}" data-key="scenarioIds" bindinput="onListInput"/></view>

    <view class="section card"><text class="section-title">模拟草稿生成</text><text class="warning">生成结果始终标记为 synthetic/unverified，不会直接发布；生成期间的人工编辑具有优先权。</text><textarea value="{{form.generationBrief}}" data-path="generationBrief" bindinput="onInput" placeholder="可选：说明希望补充的模拟内容"/><button class="secondary-button action" bindtap="startGeneration" loading="{{generating}}" disabled="{{generating}}">{{generating ? '生成任务执行中' : '保存并生成候选'}}</button><view class="job-state" wx:if="{{job}}">{{job.status}} · generation {{job.generation}}<text wx:if="{{job.resultApplied === false}}"> · 候选未覆盖新草稿</text><text wx:if="{{job.errorMessage}}"> · {{job.errorMessage}}</text></view></view>

    <view class="section card" wx:if="{{revisions.length}}"><text class="section-title">只读版本历史</text><view class="revision" wx:for="{{revisions}}" wx:key="revisionId"><text>v{{item.version}} · {{item.origin}}</text><text>{{item.publishedAt}}</text><text class="hash">{{item.contentHash}}</text></view></view>

    <view class="actions"><button class="primary-button action" bindtap="saveTapped" loading="{{saving}}">保存草稿</button><button class="secondary-button action" wx:if="{{serviceId}}" bindtap="previewDraft">可信预览</button><button class="publish-button action" wx:if="{{serviceId}}" bindtap="publishDraft">发布不可变版本</button><button class="archive-button action" wx:if="{{serviceId && status !== 'archived'}}" bindtap="archiveService">归档服务</button></view>
  </block>
</view>
