.retrain-page {
  padding: 0 24rpx 40rpx;
}

/* ── 页头 ── */
.retrain-hero {
  margin-bottom: 24rpx;
}
.retrain-eyebrow {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}
.retrain-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 12rpx;
}
.retrain-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

/* ── 加载 / 失败 ── */
.loading-card {
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
}
.retrain-failed {
  text-align: center;
}
.retrain-failed-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 12rpx;
}
.retrain-failed-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}
.retrain-failed-action {
  display: inline-block;
  padding: 16rpx 48rpx;
}

/* ── 候选场景卡 ── */
.candidate-card {
  margin-bottom: 20rpx;
}
.candidate-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.candidate-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
}
/* 比重是这个页面的排序依据，必须显眼：学员要能一眼看出「为什么这条排前面」 */
.candidate-weight {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
  padding: 6rpx 16rpx;
}
.candidate-summary {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-top: 12rpx;
}
.candidate-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.candidate-history {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--color-primary-pale, #F5F8FC);
}
.candidate-history-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.candidate-history-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-strong);
}
/* 「还没练过」是信息而不是缺陷，用弱色，不做成警示 */
.candidate-history-value.is-empty {
  font-weight: 400;
  color: var(--text-muted);
}
.candidate-also {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-muted);
  margin-top: 14rpx;
}
.candidate-action {
  margin-top: 24rpx;
}

/* ── 页脚说明 ── */
.retrain-foot {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-muted);
  text-align: center;
  padding: 8rpx 24rpx 0;
}
