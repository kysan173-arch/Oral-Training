<view class="page-shell retrain-page">
  <!-- 页头：说明推荐依据，避免学员以为这是随机推荐 -->
  <view class="retrain-hero card">
    <text class="retrain-eyebrow">弱项定向复练</text>
    <text class="retrain-title" wx:if="{{dimensionLabel}}">重点练「{{dimensionLabel}}」</text>
    <text class="retrain-title" wx:else>弱项定向复练</text>
    <text class="retrain-desc">按该维度在各场景里的训练比重排序。比重越高，在这条场景里越容易被看出这一维度上的问题。</text>
  </view>

  <!-- 该维度恰好被进行中的主管计划覆盖：只做提示，不给跳转入口 ——
       学员来这页是为了决定「练哪个场景」，把他送走会打断这个决定。 -->
  <view class="plan-banner" wx:if="{{planBanner}}">
    <view class="plan-banner-main">
      <view class="plan-banner-head">
        <text class="plan-banner-eyebrow">这个维度在你的培训计划里</text>
      </view>
      <text class="plan-banner-title">{{planBanner.title}}</text>
      <view class="plan-banner-meta">
        <text class="plan-banner-countdown">{{planBanner.countdownText}}</text>
        <text class="plan-banner-dot" wx:if="{{planBanner.countdownText}}">·</text>
        <text class="plan-banner-progress">{{planBanner.progressText}}</text>
      </view>
      <view class="plan-banner-bar"><view class="plan-banner-fill" style="width:{{planBanner.progressPercent}}%;"></view></view>
    </view>
  </view>

  <!-- 加载失败必须给重试出口：只空着会让学员读成「系统没有这个维度的场景」 -->
  <view class="retrain-failed card" wx:if="{{failed}}">
    <text class="retrain-failed-title">推荐场景加载失败</text>
    <text class="retrain-failed-text">可能是网络波动。你的训练记录与历史成绩不受影响。</text>
    <view class="retrain-failed-action btn btn-secondary" bindtap="load">重新加载</view>
  </view>

  <view class="loading-card card" wx:elif="{{loading}}"><text>正在筛选适合的场景…</text></view>

  <block wx:else>
    <view class="section-title-row">
      <text class="section-title">推荐场景</text>
      <text class="section-caption">共 {{total}} 个</text>
    </view>

    <view class="candidate-card card" wx:for="{{items}}" wx:key="id">
      <view class="candidate-head">
        <text class="candidate-name">{{item.name}}</text>
        <text class="candidate-weight">{{item.weightPercent}}%</text>
      </view>
      <text class="candidate-summary">{{item.summary}}</text>
      <view class="candidate-tags">
        <text class="tag tag-neutral">{{item.categoryLabel}}</text>
        <text class="tag tag-neutral">{{item.difficultyLabel}}</text>
        <text class="tag tag-primary" wx:if="{{item.hasCompleted}}">{{item.completedText}}</text>
      </view>
      <view class="candidate-history">
        <text class="candidate-history-label">{{dimensionLabel}}历史均分</text>
        <text class="candidate-history-value {{item.hasHistory ? '' : 'is-empty'}}">{{item.historyText}}</text>
      </view>
      <text class="candidate-also" wx:if="{{item.hasOthers}}">这条场景同时练：{{item.othersText}}</text>
      <view class="candidate-action btn btn-primary" bindtap="startTraining" data-id="{{item.id}}">{{item.actionText}}</view>
    </view>

    <empty-state wx:if="{{items.length === 0}}" title="暂无该维度的推荐场景" text="现有场景还没有标注这个维度的训练比重，所以这里不硬凑推荐。可以先按训练中心的场景练习，或请主管补充对应场景。" actionText="回到训练中心" bind:action="goTraining"></empty-state>

    <text class="retrain-foot" wx:if="{{items.length > 0}}">这些场景使用剧本默认的患者设定开始。如需调整患者的年龄、情绪或诉求，可在训练中心的场景卡片里设置后再练。</text>
  </block>
</view>
