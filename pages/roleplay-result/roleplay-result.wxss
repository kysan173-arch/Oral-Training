.roleplay-result-page { padding-bottom: 48rpx; background: var(--bg-grad, #F7F9FC); min-height: 100vh; box-sizing: border-box; }

/* ── Hero 区（白底克制 + 浅蓝灰圆形图标） ── */
.result-hero { position: relative; padding: 40rpx 24rpx 46rpx; color: var(--text-strong); background: #fff; text-align: center; border-bottom: 1rpx solid var(--color-border); }
.result-kicker { position: relative; display: block; color: var(--text-secondary); font-size: 22rpx; font-weight: 400; letter-spacing: 2rpx; }
.hero-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin: 28rpx auto 20rpx; border-radius: 50%; background: var(--color-primary-light); color: var(--color-primary); font-size: 40rpx; font-weight: 600; line-height: 1; }
.hero-title { position: relative; display: block; font-size: 40rpx; font-weight: 600; letter-spacing: 1rpx; }
.result-time { position: relative; display: block; margin-top: 16rpx; color: var(--text-muted); font-size: 22rpx; letter-spacing: .5rpx; }

/* ── 提示条（中性弱化，与训练结果页一致） ── */
.notice-box { display: flex; align-items: flex-start; margin: 22rpx 24rpx 30rpx; padding: 20rpx 24rpx; border-radius: 16rpx; color: var(--text-secondary); background: var(--color-primary-pale); font-size: 22rpx; line-height: 1.55; }
.notice-icon { width: 30rpx; height: 30rpx; line-height: 30rpx; flex-shrink: 0; margin-right: 12rpx; border-radius: 50%; text-align: center; color: var(--color-primary); background: var(--color-primary-light); font-size: 22rpx; font-weight: 600; }

/* ── 通用标题区 ── */
.section-title-row { display: flex; align-items: baseline; justify-content: space-between; margin: 0 28rpx 14rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: var(--text-strong); }
.section-caption { color: var(--text-secondary); font-size: 22rpx; }

/* ── 卡片通用 ── */
.summary-card, .list-card, .principle-card { padding: 28rpx; margin: 0 24rpx 26rpx; border-radius: 20rpx; background: #fff; border: 1rpx solid var(--color-border); }

/* ── 整体接待总结（左侧色条，不用引号） ──
   此前用中文引号把整段总结括起来，读起来像「引用了某人的话」——而 pages/result 里的引号
   恰恰是学员原话，语义完全不同。改用左侧色条表达「这是系统总结」。 */
.summary-card { position: relative; border-left: 8rpx solid var(--color-primary); }
/* 正文回常规字重。此前整页 font-weight 600 出现 10 次、400 只 1 次 —— 标题与内容同粗，
   反而没有层次（每次单看一条都觉得「这条该突出」，累积起来就等于处处都不突出）。
   .summary-quote / .topic-text / .principle-text 三处都是「内容」而非「标题」，一律 400；
   600 只留给 section-title / hero-title / hero-icon / principle-index。 */
.summary-quote { display: block; color: var(--text-strong); font-size: 28rpx; font-weight: 400; line-height: 1.6; }

/* ── 已覆盖问题 / 后续建议 ── */
.list-card { color: var(--text-body); font-size: 26rpx; line-height: 1.6; }
.topic-item { display: flex; align-items: flex-start; padding: 8rpx 0; }
.topic-item + .topic-item { border-top: 1rpx dashed var(--color-border); margin-top: 6rpx; padding-top: 16rpx; }
.topic-dot { width: 14rpx; height: 14rpx; flex-shrink: 0; margin: 18rpx 18rpx 0 2rpx; border-radius: 50%; background: var(--color-primary); }
.topic-dot-arrow { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-top: 8rpx; border-radius: 12rpx; background: var(--color-primary-light); color: var(--color-primary); font-size: 26rpx; font-weight: 600; }
.topic-text { flex: 1; color: var(--text-body); font-size: 26rpx; font-weight: 400; line-height: 1.6; }

/* ── 关键服务原则 ── */
.principle-card { display: flex; align-items: flex-start; padding: 26rpx 28rpx; }
.principle-index { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; flex-shrink: 0; margin-right: 18rpx; border-radius: 14rpx; color: var(--color-primary); background: var(--color-primary-light); font-size: 26rpx; font-weight: 600; }
.principle-text { flex: 1; color: var(--text-body); font-size: 26rpx; font-weight: 400; line-height: 1.6; }

/* ── 后续练习建议（浅蓝底） ── */
.practice-card { background: var(--color-primary-pale); }
.practice-card .topic-dot-arrow { background: var(--color-primary-light); color: var(--color-primary); }

/* ── 操作按钮 ── */
.result-actions { padding: 6rpx 24rpx 0; }
.result-actions button { width: 100%; height: 78rpx; line-height: 78rpx; margin-bottom: 16rpx; padding: 0; font-size: 26rpx; }
.action-button { border: 0; }
.disclaimer { display: block; margin-top: 8rpx; color: var(--text-secondary); font-size: 22rpx; text-align: center; }

/* ── 加载态 ── */
/* 加载卡此前 width:100% 而容器没有左右 padding -> 卡片贴屏幕边，而全页其他卡片都是 24rpx 边距。
   给容器补 padding 才治本（卡片是 flex item，光加 margin 会与 100% 抢宽度）。
   卡片自身必须显式 box-sizing: border-box：它没继承 .page-shell 的 border-box，
   content-box 下 100% + 64rpx padding 会横向溢出。 */
.loading-result { display: flex; min-height: 70vh; align-items: center; justify-content: center; padding: 0 24rpx 40rpx; background: var(--bg-grad, var(--color-bg)); }
.loading-card { width: 100%; box-sizing: border-box; padding: 48rpx 32rpx; text-align: center; background: #fff; border-radius: 20rpx; border: 1rpx solid var(--color-border); }
.loading-icon { width: 88rpx; height: 88rpx; line-height: 88rpx; margin: 0 auto 20rpx; border-radius: 50%; color: var(--color-primary); background: var(--color-primary-light); font-size: 32rpx; }
.loading-title, .loading-text { display: block; }
.loading-title { color: var(--text-strong); font-size: 32rpx; font-weight: 600; }
.loading-text { margin-top: 16rpx; color: var(--text-secondary); font-size: 26rpx; line-height: 1.6; }
.retry-button { width: 100%; margin-top: 30rpx; }
