<view class="page-shell scene-page">
  <view class="scene-header">
    <text class="eyebrow">STEP 01 / SCENE</text>
    <text class="page-title">{{trainingMode === 'patient_simulation' ? '选择患者模拟场景' : '选择客服训练场景'}}</text>
    <text class="page-intro">{{trainingMode === 'patient_simulation' ? '你将扮演患者，向标准口腔客服自由提问并学习其合规答复。' : '先了解患者公开画像，再开始一段不提供提示的真实对练。'}}</text>
  </view>

  <view class="mode-switch" aria-label="训练模式切换">
    <view class="mode-option {{trainingMode === 'customer_service' ? 'selected' : ''}}" bindtap="switchMode" data-mode="customer_service">客服训练</view>
    <view class="mode-option {{trainingMode === 'patient_simulation' ? 'selected' : ''}}" bindtap="switchMode" data-mode="patient_simulation">患者模拟</view>
  </view>

  <view class="boundary-tip"><text class="boundary-icon">i</text><text>{{trainingMode === 'patient_simulation' ? '标准客服会展示答复思路与合规边界；不提供诊断、治疗承诺或未经确认的价格信息。' : '患者隐藏信息不会直接展示，训练中请通过提问逐步了解。'}}</text></view>

  <scroll-view class="category-scroll" scroll-x="true" enable-flex="true">
    <view class="category-tabs">
      <text class="category-tab {{activeCategoryId === '' ? 'selected' : ''}}" bindtap="selectCategory" data-id="">全部场景</text>
      <text wx:for="{{categories}}" wx:key="id" class="category-tab {{activeCategoryId === item.id ? 'selected' : ''}}" bindtap="selectCategory" data-id="{{item.id}}">{{item.icon}} {{item.name}}</text>
    </view>
  </scroll-view>

  <view class="scenario-list">
    <view class="category-section" wx:for="{{visibleCategories}}" wx:for-item="category" wx:key="id">
      <view class="category-heading"><view><text class="category-title">{{category.icon}} {{category.name}}</text><text class="category-description">{{category.description}}</text></view><text class="category-count">{{category.items.length}} 个</text></view>
      <view class="scenario-card card" wx:for="{{category.items}}" wx:for-item="scenario" wx:for-index="scenarioIndex" wx:key="id">
        <view class="scenario-topline">
          <text class="scenario-index">0{{scenarioIndex + 1}}</text>
          <text class="difficulty {{scenario.difficulty === '进阶' ? 'advanced' : ''}}">{{scenario.difficulty}}</text>
          <text class="active-mark" wx:if="{{scenario.activeSession}}">进行中 · {{scenario.activeSession.currentRound}}/10轮</text>
        </view>
        <text class="scenario-name">{{scenario.name}}</text>
        <text class="scenario-summary">{{scenario.summary}}</text>
        <view class="profile-row">
          <view class="profile-avatar">{{scenario.patientAge}}</view>
          <view class="profile-copy"><text class="profile-label">{{trainingMode === 'patient_simulation' ? '患者提问场景' : '患者基础画像'}}</text><text class="profile-text">{{scenario.patientConcern}}，{{scenario.patientEmotion}}</text></view>
        </view>
        <view class="focus-row" bindtap="toggleProfile" data-id="{{scenario.id}}"><text class="focus-label">{{trainingMode === 'patient_simulation' ? '服务学习重点' : '训练重点'}}</text><text class="focus-hint">{{expandedId === scenario.id ? '收起' : '查看'}} ›</text></view>
        <view class="focus-list" wx:if="{{expandedId === scenario.id}}"><text class="focus-tag" wx:for="{{scenario.focus}}" wx:for-item="focus" wx:key="*this">{{focus}}</text></view>
        <view class="suggestion-block" wx:if="{{trainingMode === 'patient_simulation' && expandedId === scenario.id && scenario.suggestedQuestions.length}}">
          <text class="suggestion-label">可直接作为患者提问</text>
          <view class="suggestion-list"><text class="suggestion-chip" wx:for="{{scenario.suggestedQuestions}}" wx:for-item="question" wx:key="*this" bindtap="openSuggestion" data-id="{{scenario.id}}" data-prompt="{{question}}">{{question}}</text></view>
        </view>
        <view class="scenario-actions">
          <button class="primary-button scenario-button" bindtap="openTraining" data-id="{{scenario.id}}" data-mode="{{scenario.activeSession ? 'continue' : 'new'}}">{{scenario.actionText}}</button>
          <text class="restart-link" wx:if="{{scenario.activeSession}}" bindtap="restartTraining" data-id="{{scenario.id}}">重新开始</text>
        </view>
      </view>
    </view>
  </view>
</view>
