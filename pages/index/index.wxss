.scene-page { padding: 34rpx 24rpx 48rpx; }
.scene-header { padding: 8rpx 8rpx 26rpx; }
.mode-switch { display: flex; padding: 6rpx; margin: -4rpx 0 22rpx; border-radius: 20rpx; background: #e9ebf8; }
.mode-option { flex: 1; padding: 16rpx 12rpx; border-radius: 16rpx; color: #7780aa; font-size: 25rpx; text-align: center; }
.mode-option.selected { color: #fff; background: linear-gradient(135deg, #667eea, #764ba2); font-weight: 600; box-shadow: 0 5rpx 12rpx rgba(102,126,234,.22); }
.eyebrow { display: block; color: #7c86d8; font-size: 20rpx; letter-spacing: 2rpx; }
.page-title { display: block; margin-top: 14rpx; font-size: 46rpx; font-weight: 700; color: #333; }
.page-intro { display: block; margin-top: 14rpx; color: #999; font-size: 25rpx; line-height: 1.6; }
.boundary-tip { display: flex; align-items: center; padding: 20rpx 24rpx; margin-bottom: 22rpx; border-radius: 18rpx; color: #6872c9; background: #eef0ff; font-size: 23rpx; line-height: 1.5; }
.boundary-icon { width: 32rpx; height: 32rpx; line-height: 32rpx; flex-shrink: 0; margin-right: 14rpx; border-radius: 50%; text-align: center; color: #fff; background: #7b85db; font-size: 22rpx; }
.category-scroll { margin: 0 -24rpx 22rpx; white-space: nowrap; }
.category-tabs { display: inline-flex; gap: 12rpx; padding: 0 24rpx; }
.category-tab { padding: 13rpx 18rpx; border: 1rpx solid #e2e5f4; border-radius: 28rpx; color: #69749f; background: #fff; font-size: 22rpx; }
.category-tab.selected { border-color: #667eea; color: #fff; background: #667eea; }
.category-section { margin-bottom: 30rpx; }
.category-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 8rpx 14rpx; }
.category-title, .category-description { display: block; }
.category-title { color: #34405d; font-size: 29rpx; font-weight: 700; }
.category-description { margin-top: 7rpx; color: #9099b1; font-size: 21rpx; }
.category-count { color: #8790b0; font-size: 21rpx; }
.scenario-card { padding: 28rpx; margin-bottom: 20rpx; }
.scenario-topline { display: flex; align-items: center; }
.scenario-index { color: #c4c8e9; font-size: 24rpx; font-weight: 700; letter-spacing: 1rpx; }
.difficulty { margin-left: 14rpx; padding: 6rpx 16rpx; border-radius: 20rpx; color: #5268c9; background: #eef0ff; font-size: 21rpx; }
.difficulty.advanced { color: #bd7a35; background: #fff2df; }
.active-mark { margin-left: auto; color: #52a67a; font-size: 21rpx; }
.scenario-name { display: block; margin-top: 16rpx; font-size: 33rpx; font-weight: 700; }
.scenario-summary { display: block; margin-top: 10rpx; color: #777; font-size: 25rpx; line-height: 1.6; }
.profile-row { display: flex; align-items: center; padding: 20rpx 0; margin-top: 18rpx; border-top: 1rpx solid #f1f1f6; border-bottom: 1rpx solid #f1f1f6; }
.profile-avatar { width: 70rpx; height: 70rpx; line-height: 70rpx; border-radius: 22rpx; text-align: center; color: #667eea; background: #f0f1ff; font-size: 21rpx; font-weight: 700; }
.profile-copy { flex: 1; margin-left: 16rpx; }
.profile-label, .profile-text { display: block; }
.profile-label { color: #aaa; font-size: 21rpx; }
.profile-text { margin-top: 6rpx; color: #555; font-size: 24rpx; line-height: 1.45; }
.focus-row { display: flex; justify-content: space-between; align-items: center; padding-top: 18rpx; }
.focus-label { color: #555; font-size: 24rpx; font-weight: 600; }
.focus-hint { color: #7b85db; font-size: 23rpx; }
.focus-list { display: flex; flex-wrap: wrap; gap: 12rpx; padding-top: 14rpx; }
.focus-tag { padding: 7rpx 14rpx; border-radius: 18rpx; color: #667eea; background: #f5f6ff; font-size: 21rpx; }
.suggestion-block { padding-top: 18rpx; }
.suggestion-label { display: block; color: #777; font-size: 22rpx; }
.suggestion-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.suggestion-chip { padding: 10rpx 14rpx; border-radius: 16rpx; color: #5d6dc5; background: #f0f2ff; font-size: 21rpx; line-height: 1.45; }
.scenario-actions { display: flex; flex-direction: column; align-items: stretch; margin-top: 22rpx; }
.scenario-button { width: 100%; height: 76rpx; line-height: 1.2; font-size: 27rpx; }
.restart-link { align-self: center; margin-top: 16rpx; color: #9a9a9a; font-size: 23rpx; line-height: 1.5; text-align: center; }
