/* AI 训练建议：沿用培训页的克制白底风格——细边框、无阴影堆叠、无渐变，
   主色只用于「采纳并发布」这一个主行动按钮。 */

.ai-page {
  padding-bottom: 40rpx;
}

.loading-card {
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
}

/* ── 头部说明 ── */
.ai-hero {
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-hero-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.ai-hero-desc {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

/* ── 生成按钮行 ── */
.ai-toolbar {
  margin: 24rpx 24rpx 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.ai-generate-btn {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  background: var(--color-primary-light);
  font-size: 26rpx;
}

.ai-generate-btn.disabled {
  opacity: 0.5;
}

.ai-toolbar-hint {
  font-size: 23rpx;
  color: var(--text-tertiary);
}

/* ── 建议卡片 ── */
.ai-card {
  margin: 20rpx 24rpx 0;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.ai-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-learner {
  font-size: 27rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.ai-source {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.ai-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.5;
}

/* 目标维度：达标口径的说明，弱于标题、强于辅助文字 */
.ai-focus {
  font-size: 24rpx;
  color: var(--color-primary);
  line-height: 1.5;
}

/* 推荐理由是主管判断「采不采纳」的核心依据，用左侧竖线做视觉锚点 */
.ai-rationale-box {
  padding: 20rpx 24rpx;
  border-left: 4rpx solid var(--color-primary);
  background: var(--color-bg);
  border-radius: 0 12rpx 12rpx 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ai-rationale-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.ai-rationale {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.ai-scene-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ai-scene-tag {
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--border-color);
  font-size: 23rpx;
  color: var(--text-secondary);
}

.ai-requirement {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ── 卡片动作 ── */
.ai-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
}

.ai-btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  border: 1rpx solid var(--border-color);
  color: var(--text-secondary);
  background: transparent;
}

.ai-btn-primary {
  flex: 2;
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #FFFFFF;
}

/* 次要动作：同为主色但只描边，与实心的主行动区分开 */
.ai-btn-secondary {
  color: var(--color-primary);
  border-color: var(--color-primary);
}

.ai-actions-sub {
  margin-top: 12rpx;
}

.ai-btn-ghost {
  color: var(--color-danger);
  border-color: var(--color-danger);
}

.ai-btn.disabled {
  opacity: 0.5;
}

.ai-note {
  display: block;
  margin: 28rpx 40rpx 0;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--text-tertiary);
}
