<view class="page-shell phrases-page">
  <view class="page-header">
    <text class="eyebrow">LEARNING LIBRARY</text>
    <text class="page-title">{{favoritesOnly ? '我的话术收藏' : '话术锦囊'}}</text>
    <text class="page-intro">从你已完成的训练报告中提炼的合规表达，可复制后结合实际情境调整使用。</text>
  </view>

  <view class="phrase-view-switch"><text class="phrase-view {{!favoritesOnly ? 'selected' : ''}}" bindtap="selectPhraseView" data-favorites="false">全部话术</text><text class="phrase-view {{favoritesOnly ? 'selected' : ''}}" bindtap="selectPhraseView" data-favorites="true">我的收藏</text></view>

  <view class="search-card card">
    <input class="search-input" placeholder="搜索场景、患者关切或话术" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" />
    <text class="search-action" bindtap="onSearchConfirm">搜索</text>
    <text class="clear-action" wx:if="{{keyword}}" bindtap="clearSearch">清除</text>
  </view>

  <scroll-view class="filter-scroll" scroll-x="true" enable-flex="true">
    <view class="filter-row">
      <text wx:for="{{scenarioFilters}}" wx:key="id" class="filter-chip {{selectedScenarioId === item.id ? 'selected' : ''}}" bindtap="selectScenario" data-id="{{item.id}}">{{item.name}}</text>
    </view>
  </scroll-view>

  <view class="loading-card card" wx:if="{{loading}}"><text>正在整理训练话术…</text></view>
  <view class="empty-card card" wx:elif="{{phrases.length === 0}}">
    <text class="empty-title">{{favoritesOnly ? '还没有收藏话术' : '还没有可收录的话术'}}</text>
    <text class="empty-text">{{favoritesOnly ? '在话术锦囊中点击收藏后，可在这里集中回顾。' : '完成客服训练并生成报告后，关键轮次的优化表达会自动出现在这里。'}}</text>
    <button class="primary-button" bindtap="goProfile">查看成长记录</button>
  </view>

  <view class="phrase-list" wx:else>
    <view class="phrase-card card" wx:for="{{phrases}}" wx:key="id">
      <view class="phrase-head"><text class="scene-tag">{{item.scenarioName}}</text><text class="round-tag">第 {{item.round}} 轮</text></view>
      <view class="patient-box" wx:if="{{item.patientSays}}"><text class="patient-label">患者关切</text><text>{{item.patientSays}}</text></view>
      <view class="phrase-box"><text class="phrase-label">推荐表达</text><text class="phrase-text">{{item.csReply}}</text></view>
      <text class="reason-text">{{item.reason}}</text>
      <view class="phrase-actions"><text class="copy-action" bindtap="copyPhrase" data-phrase="{{item.csReply}}">复制话术</text><text class="favorite-action {{item.favorited ? 'active' : ''}}" bindtap="toggleFavorite" data-session-id="{{item.sessionId}}" data-phrase-key="{{item.phraseKey}}">{{favoriteBusyId === item.id ? '处理中…' : item.favorited ? '★ 已收藏' : '☆ 收藏'}}</text><text class="train-action" bindtap="startScenario" data-id="{{item.scenarioId}}">用此场景复练 ›</text></view>
    </view>
  </view>

  <view class="bottom-links"><text bindtap="goMistakes">去错题复练</text><text bindtap="goProfile">查看个人成长</text></view>
</view>
