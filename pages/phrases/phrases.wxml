<view class="page-shell phrases-page">
  <view class="page-header">
    <text class="page-title">{{favoritesOnly ? '我的话术收藏' : '话术锦囊'}}</text>
    <text class="page-intro">从你已完成的训练报告中提炼的合规表达，可复制后结合实际情境调整使用。</text>
  </view>

  <view class="phrase-view-switch"><text class="phrase-view {{!favoritesOnly ? 'selected' : ''}}" bindtap="selectPhraseView" data-favorites="false">全部话术</text><text class="phrase-view {{favoritesOnly ? 'selected' : ''}}" bindtap="selectPhraseView" data-favorites="true">我的收藏</text></view>

  <!-- 场景分类筛选：与「全部话术/我的收藏」「关键词搜索」三者可叠加 -->
  <scroll-view class="category-filter" scroll-x scroll-with-animation>
    <view class="category-chip {{sceneCategory === '' ? 'selected' : ''}}" bindtap="selectSceneCategory" data-category="">全部场景</view>
    <view class="category-chip {{sceneCategory === item.id ? 'selected' : ''}}" wx:for="{{sceneCategories}}" wx:key="id" bindtap="selectSceneCategory" data-category="{{item.id}}">{{item.name}}</view>
  </scroll-view>

  <view class="search-card card">
    <input class="search-input" placeholder="搜索场景、患者关切或话术" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" />
    <text class="search-action" bindtap="onSearchConfirm">搜索</text>
    <text class="clear-action" wx:if="{{keyword}}" bindtap="clearSearch">清除</text>
  </view>

  <view class="phrase-skeleton" wx:if="{{loading}}">
    <view class="sk-card"></view>
    <view class="sk-card"></view>
    <view class="sk-card"></view>
  </view>
  <view class="empty-card card" wx:elif="{{phrases.length === 0}}">
    <empty-state title="{{emptyCopy.title}}" text="{{emptyCopy.text}}"></empty-state>
  </view>

  <view class="phrase-list" wx:else>
    <view class="phrase-card card" wx:for="{{phrases}}" wx:key="id">
      <view class="phrase-head"><text class="scene-name">{{item.scenarioName}}</text><text class="round-tag">第 {{item.round}} 轮</text></view>
      <view class="patient-box" wx:if="{{item.patientSays}}"><text class="patient-label">患者关切</text><text class="patient-text">{{item.patientSays}}</text></view>
      <view class="phrase-box"><text class="phrase-label">推荐表达</text><text class="phrase-text">{{item.csReply}}</text></view>
      <text class="reason-text">{{item.reason}}</text>
      <view class="phrase-actions">
        <text class="favorite-action {{item.favorited ? 'active' : ''}}" bindtap="toggleFavorite" data-session-id="{{item.sessionId}}" data-phrase-key="{{item.phraseKey}}">{{favoriteBusyId === item.id ? '处理中…' : item.favorited ? '★ 已收藏' : '☆ 收藏'}}</text>
        <view class="phrase-action-right">
          <text class="copy-action" bindtap="copyPhrase" data-phrase="{{item.csReply}}">复制话术</text>
          <text class="train-action" bindtap="startScenario" data-id="{{item.scenarioId}}">用此场景复练 ›</text>
        </view>
      </view>
    </view>
  </view>
</view>
