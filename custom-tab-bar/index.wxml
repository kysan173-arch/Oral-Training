<view class="tab-bar">
  <view
    class="tab-item {{selected === index ? 'selected' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    wx:for-index="index"
    data-path="{{item.pagePath}}"
    bindtap="switchTab"
  >
    <image class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}"></image>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
