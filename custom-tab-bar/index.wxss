.tab-bar {
  display: flex;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(180deg, #EEF0FF 0%, #E3E8FF 100%);
  border-top: 1rpx solid rgba(91, 110, 245, .08);
  box-shadow: 0 -4rpx 20rpx rgba(91, 110, 245, .06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0 10rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #A1A1AA;
}

.tab-item.selected .tab-text {
  color: #5B6EF5;
  font-weight: 600;
}
