# PostgreSQL connection. Never commit a real password.
DATABASE_URL=postgresql://oral_training_app:<password>@127.0.0.1:5432/oral_training
# Lazy shared connection pool. Size must be at least AI_WORKER_CONCURRENCY + 2.
DATABASE_POOL_SIZE=12
DATABASE_POOL_WAIT_MS=3000

# DeepSeek settings. Request URL, request options and prompts are defined in code.
# Health remains HTTP 503 until a key is configured here or through the local runtime endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Local controlled demo: demo auth still issues a server-side bearer token.
PRODUCTION=false
AUTH_MODE=demo
AUTH_TOKEN_TTL_SECONDS=604800

# Required when AUTH_MODE=wechat.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Runtime key upload is honored only outside production and on a loopback bind.
ALLOW_RUNTIME_API_KEY=true
BIND_ADDRESS=127.0.0.1
PORT=8080

# Production must use one exact origin and an HTTPS reverse proxy.
ALLOWED_ORIGIN=*
REQUIRE_HTTPS=false
# Comma-separated exact IP addresses of reverse proxies allowed to supply
# X-Forwarded-For and X-Forwarded-Proto. Required in production.
TRUSTED_PROXY_IPS=
RATE_LIMIT_PER_MINUTE=120

# Same-process reliable AI worker; clamped to 1-4.
AI_WORKER_CONCURRENCY=1
