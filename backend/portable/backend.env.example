# PostgreSQL connection used by the local backend. Do not commit a real password.
DATABASE_URL=postgresql://oral_training_app:<password>@127.0.0.1:5432/oral_training

# Configure your personal model in My > LiteLLM model configuration after migrations 034-035.
# Model credentials are encrypted in PostgreSQL, not read from environment variables.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Service training is enabled; legacy RAG_*_ENABLED flags are ignored.
# 0 = uncapped normal operation.
# Controlled smoke must set a positive cap (e.g. 16); retries consume the same process-wide cap.
MODEL_CALL_LIMIT=0

# Semantic RAG: apply migration 036, then run EmbeddingGemma on the backend host.
# Base URL excludes /embeddings; HTTP is allowed only on loopback.
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:8765/v1
RAG_EMBEDDING_MODEL=embeddinggemma-2
RAG_EMBEDDING_DIMENSIONS=768
RAG_EMBEDDING_REVISION=1
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MIN_SIMILARITY=0.65
