.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 70rpx 30rpx;
  text-align: center;
}
.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--color-primary-light);
  font-size: 40rpx;
  margin-bottom: 20rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
}
.empty-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}
.empty-btn {
  margin-top: 24rpx;
  padding: 0 48rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  color: #fff;
  background: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
}
.empty-btn::after { border: none; }
