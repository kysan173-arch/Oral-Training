<view class="chat-message {{roleClass}}">
  <view class="msg-avatar">{{avatar}}</view>
  <view class="msg-body">
    <view class="msg-bubble">
      <text class="msg-content">{{message.content}}</text>
    </view>
    <view class="msg-meta" wx:if="{{roleClass === 'msg-patient' && emotionLabel}}">
      <text class="emotion-tag {{emotionClass}}">{{emotionLabel}}</text>
      <text class="msg-time">{{message.createdAt}}</text>
    </view>
    <view class="msg-meta" wx:elif="{{roleClass !== 'msg-system'}}">
      <text class="msg-time">{{message.createdAt}}</text>
    </view>
  </view>
</view>
