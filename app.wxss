/* ============================================================
   app.wxss - 全局设计系统（Design Tokens + 通用工具类）
   ============================================================ */

/* ── 1. 设计 Token ───────────────────────────────
   收敛原则：主色不超过 3 个（品牌蓝 / 警示橙 / 中性灰），
   字重仅 400 / 600，字号仅 32 / 26 / 22。 */
page {
  /* 主色（品牌蓝） */
  --color-primary: #1F3864;          /* 主色（深海军蓝） */
  --color-primary-dark: #16294D;     /* 主色·按压/深 */
  --color-primary-light: #EEF2F8;    /* 主色·浅底 */
  --color-primary-pale: #F5F8FC;     /* 主色·极浅底 */

  /* 警示（唯一状态色） */
  --color-warning: #B97A1E;          /* 唯一警示/状态色 */
  --color-warning-light: #FBF1E2;    /* 警示·浅底 */

  /* 中性（文字/底） */
  --text-strong: #16233B;            /* 标题文字（主文字） */
  --text-body: #3C4658;              /* 正文 */
  --text-secondary: #6B7A93;         /* 次级文字（统一中性灰） */
  --text-muted: #9AA6B8;             /* 弱文字/占位 */
  --text-disabled: #C6CDD8;          /* 禁用 */
  --color-border: #E3E9F2;           /* 分隔线/边框 */
  --color-bg: #F7F9FC;               /* 页面背景（浅蓝灰） */
  --bg-grad: linear-gradient(180deg, #F9FBFD 0%, #F2F5F9 100%);  /* 浅蓝灰渐变 */

  /* 语义色（达标 / 提醒 / 违规，仅用于状态与分数分档） */
  --color-success: #2E8B6C;          /* 达标 / 良好 */
  --color-success-light: #E7F4EE;
  --color-warning: #B97A1E;          /* 提醒 / 待提升 */
  --color-warning-light: #FBF1E2;
  --color-danger:  #C2554A;          /* 违规 / 负向 */
  --color-danger-light: #FBE9E7;

  /* 圆角 */
  --radius-lg: 24rpx;                /* 大卡 */
  --radius-md: 16rpx;                /* 中卡/按钮 */
  --radius-sm: 10rpx;                /* 标签/输入 */

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);

  /* 基础 */
  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB',
    'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-body);
  box-sizing: border-box;
}

/* ── 2. 布局容器 ─────────────────────────────── */
.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  background: var(--bg-grad, var(--color-bg));
}

.container {
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* ── 3. 卡片 ───────────────────────────────────
   层级原则：普通卡片用 1rpx 边框；主视觉卡（hero、概览卡）
   由各自页面显式加强阴影，形成主次。 */
.card {
  background: var(--color-surface, #fff);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  border: 1rpx solid var(--color-border);
}
.card.card-press {
  transition: transform .15s, box-shadow .15s;
}
.card.card-press:active {
  transform: scale(.99);
  box-shadow: var(--shadow-md);
}

/* ── 4. 标题层级 ─────────────────────────────── */
.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
  margin: 8rpx 0 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-strong);
  letter-spacing: .5rpx;
}
.section-caption {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ── 5. 文本工具 ─────────────────────────────── */
.text-strong { color: var(--text-strong); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.muted { color: var(--text-muted); }
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.clearfix::after {
  content: '';
  display: table;
  clear: both;
}

/* ── 6. 按钮 ─────────────────────────────────── */
button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}
button::after { border: none; }

.btn {
  border-radius: 60rpx;
  font-size: 26rpx;
  padding: 20rpx 0;
  text-align: center;
  transition: opacity .15s;
}
.btn:active { opacity: .85; }

.btn-primary {
  background: var(--color-primary);
  color: #fff;
}
.btn-secondary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}
.btn-disabled {
  background: #E8E9F0;
  color: var(--text-muted);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary);
  color: #fff;
  border-radius: 46rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: opacity .15s, transform .1s;
}
.primary-button:active { opacity: .88; }

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-light);
  color: var(--color-primary);
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 400;
  transition: opacity .15s;
}
.secondary-button:active { opacity: .85; }

/* ── 7. 标签 ─────────────────────────────────── */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
}
.tag-primary { color: var(--color-primary); background: var(--color-primary-light); }
.tag-success { color: var(--color-success); background: var(--color-success-light); }
.tag-warning { color: var(--color-warning); background: var(--color-warning-light); }
.tag-danger  { color: var(--color-danger); background: var(--color-danger-light); }
.tag-neutral { color: var(--text-secondary); background: var(--color-bg); }

/* ── 7.5 分数分档（颜色只跟随分数高低，不按维度分配） ── */
.tier-high { color: var(--color-success); }
.tier-mid  { color: var(--color-primary); }
.tier-low  { color: var(--color-warning); }
.fill-high { background: var(--color-success); }
.fill-mid  { background: var(--color-primary); }
.fill-low  { background: var(--color-warning); }

/* ── 8. 通用间距工具（倍距体系 8/12/16/20/24） ── */
.mt-8 { margin-top: 8rpx; } .mb-8 { margin-bottom: 8rpx; }
.mt-12 { margin-top: 12rpx; } .mb-12 { margin-bottom: 12rpx; }
.mt-16 { margin-top: 16rpx; } .mb-16 { margin-bottom: 16rpx; }
.mt-20 { margin-top: 20rpx; } .mb-20 { margin-bottom: 20rpx; }
.mt-24 { margin-top: 24rpx; } .mb-24 { margin-bottom: 24rpx; }
