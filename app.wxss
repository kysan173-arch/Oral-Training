/* app.wxss - 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  padding-bottom: 30rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

button::after {
  border: none;
}

/* 按钮样式 */
.btn {
  border-radius: 60rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.btn-secondary {
  background: #f0f0f0;
  color: #666;
}

.btn-disabled {
  background: #ccc;
  color: #999;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
  background: #f5f5f5;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef3ff;
  color: #5268c9;
  border-radius: 40rpx;
  font-size: 26rpx;
}

.muted {
  color: #999;
}

/* 文本省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 清除浮动 */
.clearfix::after {
  content: '';
  display: table;
  clear: both;
}
